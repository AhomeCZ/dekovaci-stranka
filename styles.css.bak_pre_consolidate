/* Hlavní layout, komponenty a animace – nezávislé na barevném motivu */

/* ============================================================
   TOKENY
   ============================================================ */
:root{
  --s1:4px; --s2:8px; --s3:12px; --s4:16px; --s6:24px; --s8:32px; --s12:48px;
  --r-sm:8px; --r-md:10px; --r-lg:14px; --r-tile:10px; --r-pill:999px;
  --shadow:0 1px 2px rgba(30,23,38,.05);
}

*,*::before,*::after{box-sizing:border-box;}
html{-webkit-text-size-adjust:100%;}
body{
  margin:0;
  background: var(--bg)!important;
  color:var(--ink);
  font-family:'Poppins',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
  font-size:16px;
  line-height:1.5;
  padding-bottom:calc(160px + env(safe-area-inset-bottom));
}
img{max-width:100%;display:block;}
button,input{font:inherit;color:inherit;}
:focus-visible{outline:2px solid var(--violet);outline-offset:2px;border-radius:var(--r-sm);}

.page{max-width:1120px;margin:0 auto;padding:var(--s4) var(--s4) var(--s8);}

/* ============================================================
   IKONOVÁ DLAŽDICE — sdílená komponenta
   ============================================================ */
.tile{
  flex:0 0 auto;
  width:44px;height:44px;
  display:grid;place-items:center;
  background:var(--violet-tint);
  border-radius:var(--r-tile);
  color:var(--violet);
}
.tile svg{width:22px;height:22px;}

/* ============================================================
   1 ▸ POTVRZENÍ + ÚPRAVA E-MAILU
   ============================================================ */
.confirm{
  display:flex;
  gap:var(--s3);
  align-items:flex-start;
  background:var(--green-tint);
  border:1px solid #D7E4D3;
  border-radius:var(--r-md);
  padding:var(--s4);
}
.confirm > svg{flex:0 0 auto;margin-top:2px;}
.confirm-body{flex:1 1 auto;min-width:0;}
.confirm h1{margin:0;font-size:1rem;font-weight:700;line-height:1.35;white-space:nowrap;}
.confirm p{margin:var(--s1) 0 0;font-size:.875rem;color:var(--ink-muted);word-break:break-word;}
.confirm p b{font-weight:600;color:var(--ink);}

.icon-btn{
  flex:0 0 auto;
  width:44px;height:44px;
  display:grid;place-items:center;
  background:#fff;
  border:1px solid #D7E4D3;
  border-radius:var(--r-sm);
  color:var(--ink-muted);
  cursor:pointer;
  transition:color .15s ease,border-color .15s ease;
}
.icon-btn:hover{color:var(--violet);border-color:var(--violet);}
.icon-btn svg{width:21px;height:21px;}

.mail-edit{display:flex;flex-wrap:wrap;gap:var(--s2);margin-top:var(--s3);}
.mail-edit[hidden]{display:none;}
.mail-edit input{
  flex:1 1 200px;min-width:0;
  padding:var(--s2) var(--s3);
  background:#fff;
  border:1px solid #D7E4D3;
  border-radius:var(--r-sm);
  font-size:.875rem;
}
.mail-edit input:focus{outline:2px solid var(--violet);outline-offset:0;border-color:transparent;}
.btn-ghost,.btn-solid{
  padding:var(--s2) var(--s4);
  border-radius:var(--r-sm);
  font-size:.8125rem;font-weight:400;cursor:pointer;
}
.btn-solid{background:var(--violet);border:1px solid var(--violet);color:#fff;}
.btn-solid:hover{background:var(--violet-dark);}
.btn-ghost{background:transparent;border:1px solid transparent;color:var(--ink-muted);}
.btn-ghost:hover{color:var(--ink);}

/* ============================================================
   2 ▸ TIP OD MASKOTA
   ============================================================ */
.tip{
  position:relative;
  display:flex;align-items:center;gap:var(--s3);
  width:100%;margin-top:var(--s3);
  padding:var(--s3) var(--s4) var(--s3) var(--s3);
  background:var(--violet-tint);
  border:1px solid #E3DDEE;
  border-radius:18px;
  text-align:left;cursor:default;
  transition:background .15s ease;
}
.tip::after{
  content:"";
  position:absolute;
  left:30px;
  bottom:-8px;
  width:15px;
  height:15px;
  background: #F6F2F9 !important;
  border-right:1px solid #E3DDEE;
  border-bottom:1px solid #E3DDEE;
  transform:rotate(45deg);
}
.tip:hover{background:var(--violet-tint);}
.tip-copy{flex:1 1 auto;min-width:0;}
.tip-copy strong{display:block;font-size:.9375rem;font-weight:700;}
.tip-copy span{display:block;font-size:.875rem;color:var(--ink-muted);}
.chev{flex:0 0 auto;color:var(--violet);width:20px;height:20px;}

/* MASKOTI */
.mascot{flex:0 0 auto;object-fit:contain;}
.mascot--tip{width:64px;height:64px;}
.mascot--bar{width:76px;height:60px;}

/* ============================================================
   3 ▸ HLAVIČKA SEKCE
   ============================================================ */
.section-head{
  display:flex;align-items:center;gap:var(--s3);
  margin-top:var(--s8);
}
.section-head .head-copy{flex:1 1 auto;min-width:0;}
.section-head h2{margin:0;font-size:1.1875rem;font-weight:800;letter-spacing:-.015em;line-height:1.25;}
.section-head p{margin:var(--s1) 0 0;font-size:.875rem;color:var(--ink-muted);max-width:52ch;}
.doodle{display:none;flex:0 0 auto;color:var(--magenta);}

/* ============================================================
   KARTA PRODUKTU
   ============================================================ */
.grid{
  list-style:none;margin:var(--s4) 0 0;padding:0;
  display:grid;gap:var(--s2);
  grid-template-columns:repeat(2,minmax(0,1fr));
}
.item{
  display:flex;flex-direction:column;
  background:var(--surface);
  border:1px solid var(--line);
  border-radius:var(--r-md);
  padding:var(--s2);
  transition:border-color .15s ease;
}
.item:hover{border-color:#D8CBE8;}
.item[hidden]{display:none;}

.thumb{
  width:100%;aspect-ratio:4/3;
  border-radius:var(--r-sm);
  background:#F3F0F7;display:grid;place-items:center;
  color:#BDB4CC;overflow:hidden;
}
.thumb img{width:100%;height:100%;object-fit:cover;}

.item-body{padding:6px 2px var(--s2);min-width:0;}

/* důvod doporučení — jen text, bez pilulky, ať karta neroste */
.reason{
  display:block;font-size:.6875rem;line-height:1.3;
  color:var(--violet);font-weight:600;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
.name{
  margin:2px 0 0;font-size:.8125rem;font-weight:400;line-height:1.3;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;
  overflow:hidden;min-height:2.6em;
}
.prices{display:flex;align-items:baseline;flex-wrap:wrap;gap:0 6px;margin-top:1px;}
.price{font-size:1.0625rem;font-weight:800;color:var(--ink);}
.price-old{font-size:.75rem;color:var(--magenta);text-decoration:line-through;}

/* tlačítko přidat — gradient ze zadání, ukotvené dole */
.add{
  width:100%;
  margin-top:auto;
  padding:7px var(--s2);
  background:var(--grad-add);
  border:0;border-radius:var(--r-sm);
  color:#fff;font-size:.8125rem;font-weight:400;
  cursor:pointer;
  box-shadow:0 2px 6px rgba(107,67,206,.22);
  transition:filter .15s ease,box-shadow .15s ease,transform .18s cubic-bezier(.34,1.56,.64,1);
}
.add:active{transform:scale(.93);transition-duration:.12s;}
.add:hover{filter:brightness(1.08);box-shadow:0 3px 10px rgba(107,67,206,.3);}
.add[aria-pressed="true"]{
  background:#fff;color:var(--violet);
  box-shadow:none;border:1px solid var(--violet);
  padding:6px calc(var(--s2) - 1px);
}

/* donačítání při scrollu */
.sentinel{
  display:grid;place-items:center;
  height:56px;margin-top:var(--s3);
}
.sentinel[hidden]{display:none;}
.spinner{
  width:22px;height:22px;border-radius:50%;
  border:2.5px solid var(--line);
  border-top-color:var(--violet);
  animation:spin .8s linear infinite;
}
@keyframes spin{to{transform:rotate(360deg);}}

/* ============================================================
   QR MODÁL
   ============================================================ */
.backdrop{
  position:fixed;inset:0;z-index:60;
  background:rgba(30,23,38,.55);
  display:grid;place-items:center;
  padding:var(--s4);
  overflow-y:auto;
}
.backdrop[hidden]{display:none;}
.modal{
  width:100%;max-width:380px;
  background:var(--surface);
  border-radius:var(--r-lg);
  padding:var(--s6) var(--s6) var(--s4);
  text-align:center;
  position:relative;
}
.modal h2{margin:0;font-size:1.125rem;font-weight:800;}
.modal .sub{margin:var(--s2) 0 0;font-size:.875rem;color:var(--ink-muted);}
.qr{
  width:200px;height:200px;
  margin:var(--s4) auto var(--s3);
  padding:var(--s3);
  background:#fff;
  border:1px solid var(--line);
  border-radius:var(--r-md);
}
.qr svg{width:100%;height:100%;display:block;}
.pay-rows{
  text-align:left;
  background:var(--violet-tint);
  border-radius:var(--r-md);
  padding:var(--s3);
  font-size:.8125rem;
}
.pay-rows div{display:flex;justify-content:space-between;gap:var(--s3);padding:2px 0;}
.pay-rows dt{color:var(--ink-muted);}
.pay-rows dd{margin:0;font-weight:700;}
.modal-close{
  width:100%;margin-top:var(--s4);padding:var(--s3);
  background:none;border:0;color:var(--ink-muted);
  font-size:.875rem;font-weight:600;cursor:pointer;border-radius:var(--r-sm);
}
.modal-close:hover{color:var(--ink);background:var(--line-soft);}
.modal-x{
  position:absolute;top:var(--s3);right:var(--s3);
  width:32px;height:32px;display:grid;place-items:center;
  background:none;border:0;border-radius:var(--r-sm);
  color:var(--ink-faint);cursor:pointer;
}
.modal-x:hover{color:var(--ink);background:var(--line-soft);}

/* ============================================================
   4 ▸ PŘÍBĚH
   ============================================================ */
.story{
  margin-top:var(--s8);background:var(--surface);
  border:1px solid var(--line);border-radius:var(--r-md);overflow:hidden;
}
.story-img{aspect-ratio:16/9;background:#EFE9E1;display:grid;place-items:center;color:#B9AC9B;overflow:hidden;}
.story-img img{width:100%;height:100%;object-fit:cover;}
.story-copy{padding:var(--s4);}
.story-copy h3{margin:0 0 var(--s2);font-size:1rem;font-weight:700;}
.story-copy p{margin:0;font-size:.875rem;color:var(--ink-muted);max-width:56ch;}

/* ============================================================
   5 ▸ FAQ
   ============================================================ */
.faq{
  display:flex;align-items:center;gap:var(--s3);
  width:100%;margin-top:var(--s3);padding:var(--s3) var(--s4) var(--s3) var(--s3);
  background:var(--surface);border:1px solid var(--line);border-radius:var(--r-md);
  text-align:left;cursor:pointer;transition:border-color .15s ease;
}
.faq:hover{border-color:#D9CDEB;}
.faq-copy{flex:1 1 auto;}
.faq-copy strong{display:block;font-size:.9375rem;font-weight:700;}
.faq-copy span{display:block;font-size:.875rem;color:var(--ink-muted);}

/* ============================================================
   6 ▸ SOUHRN
   ============================================================ */
.summary{
  position:fixed;left:0;right:0;bottom:0;z-index:20;
  background:var(--surface);border-top:1px solid var(--line);
  padding:var(--s3) var(--s4) calc(var(--s3) + env(safe-area-inset-bottom));
  box-shadow:0 -2px 14px rgba(30,23,38,.07);
  transform:translateY(130%);
  transition:transform .34s cubic-bezier(.22,1,.36,1);
}
.summary.is-visible{transform:translateY(0);}
.summary-inner{max-width:1120px;margin:0 auto;position:relative;}
.summary-top{display:flex;align-items:center;gap:var(--s3);}

/* --- 1 · Levandulka přilétá na supermanovi --- */
.summary .mascot--bar{
  display:block;
  position:absolute;left:2px;top:-58px;
  width:92px;height:auto;
  pointer-events:none;
  opacity:0;
  transform:translateX(-140px) rotate(12deg);
  transition:opacity .32s ease,transform .32s ease;
}
.summary[data-state="filled"] .mascot--bar{
  animation:cat-fly 1.1s cubic-bezier(.34,1.56,.64,1) forwards,
            cat-float 3.2s 1.1s ease-in-out infinite;
}
@keyframes cat-fly{to{opacity:1;transform:none;}}
@keyframes cat-float{50%{transform:translateY(-5px) rotate(-2deg);}}

/* --- 3 · časovač, který tiká --- */
.timer{
  flex:0 0 auto;position:relative;width:68px;height:68px;
  animation:tick 1s steps(1,end) infinite;
}
@keyframes tick{
  0%{transform:scale(1.05);}
  45%{transform:scale(1);}
  100%{transform:scale(1);}
}
.timer.is-urgent{animation-duration:.6s;}
.timer.is-critical{animation-duration:.5s;}
.timer.is-done{animation:none;}
.timer svg.ring{position:absolute;inset:0;width:68px;height:68px;transform:rotate(126deg);}
.timer .track{fill:none;stroke:#EDE6F4;stroke-width:5;stroke-linecap:round;}
.timer .prog{fill:none;stroke:url(#ringGrad);stroke-width:5;stroke-linecap:round;
  transition:stroke-dashoffset 1s linear;}
.timer.is-urgent .prog{stroke:var(--magenta);}
.timer.is-done .prog{stroke:#C9C3D2;}
.timer-face{
  position:absolute;inset:0;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;
}
.timer-face .clock{font-size:.875rem;font-weight:700;color:var(--magenta);font-variant-numeric:tabular-nums;line-height:1;}
.timer-face .paw{width:15px;height:15px;color:var(--magenta);}
.timer.is-done .clock,.timer.is-done .paw{color:var(--ink-faint);}

.summary-note{flex:1 1 auto;min-width:0;}
.summary-note strong{display:block;font-size:.875rem;font-weight:700;line-height:1.3;}
.summary-note span{display:block;font-size:.75rem;color:var(--ink-muted);transition:opacity .15s ease;}
.summary-note span.is-fading{opacity:0;}

.total{flex:0 0 auto;text-align:right;}
.total span{display:block;font-size:.75rem;color:var(--ink-muted);}
.total strong{display:block;font-size:1.5rem;font-weight:800;color:var(--magenta);letter-spacing:-.015em;}
.total.bump{animation:bump .26s cubic-bezier(.34,1.56,.64,1);}
@keyframes bump{50%{transform:scale(1.08);}}

.cta{
  display:flex;align-items:center;justify-content:center;gap:var(--s2);
  width:100%;margin-top:var(--s3);padding:var(--s4);
  background:var(--grad-cta);border:0;border-radius:var(--r-pill);
  color:#fff;font-size:1.0625rem;font-weight:400;cursor:pointer;
  transition:filter .15s ease;
}
.cta.is-entering{animation:cta-in .15s ease forwards;}
@keyframes cta-in{from{opacity:.55;}to{opacity:1;}}
.cta:hover{filter:brightness(1.07);}
.cta svg{width:20px;height:20px;}

.summary[data-state="empty"] .total,
.summary[data-state="empty"] .cta{display:none;}

/* ============================================================
   ≥700px — tablet
   ============================================================ */
@media (min-width:700px){
  .page{padding:var(--s6) var(--s6) var(--s12);}
  .grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--s3);}
  .name{font-size:.875rem;}
  .price{font-size:1rem;}
  .add{font-size:.875rem;padding:var(--s2) var(--s3);}
  .add[aria-pressed="true"]{padding:calc(var(--s2) - 1px) calc(var(--s3) - 1px);}
  .section-head h2{font-size:1.375rem;}
  .doodle{display:block;}
  .story{display:grid;grid-template-columns:minmax(0,42%) 1fr;align-items:center;}
  .story-img{height:100%;aspect-ratio:auto;min-height:200px;}
  .story-copy{padding:var(--s6);}
  .summary .mascot--bar{width:104px;top:-64px;left:8px;}
}

/* ============================================================
   ≥1024px — desktop: souhrn se stane ukotveným sloupcem
   ============================================================ */
@media (min-width:1024px){
  body{padding-bottom:120px;}
  .page{max-width:1120px;padding:var(--s12) var(--s8) var(--s12);}
  .confirm{align-items:center;}
  .confirm h1{font-size:1.125rem;}

  .section-head{margin-top:var(--s12);}
  .grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--s3);}
  .item{padding:var(--s3);}
  .item-body{padding:var(--s2) 2px var(--s3);}
  .name{font-size:.9375rem;min-height:2.6em;}
  .price{font-size:1.0625rem;}
  .price-old{font-size:.75rem;}
  .add{font-size:.9375rem;padding:var(--s3) var(--s4);}
  .add[aria-pressed="true"]{padding:calc(var(--s3) - 1px) calc(var(--s4) - 1px);}

  /* souhrn zůstává ukotvený dole — časovač je vidět po celý scroll */
  .summary{padding:var(--s3) var(--s8) var(--s4);}
  .summary-inner{display:flex;align-items:center;gap:var(--s6);}
  .summary .mascot--bar{width:132px;top:-76px;left:var(--s8);}
  .summary-top{flex:1 1 auto;gap:var(--s4);}
  .summary-note strong{font-size:1rem;}
  .summary-note span{font-size:.8125rem;}
  .total{margin-left:auto;text-align:right;}
  .total strong{font-size:1.75rem;}
  .cta{width:auto;flex:0 0 auto;margin-top:0;padding:var(--s3) var(--s8);font-size:1rem;}

  .story{grid-template-columns:minmax(0,46%) 1fr;}
  .story-img{min-height:260px;}
  .story-copy{padding:var(--s8);}
  .story-copy h3{font-size:1.25rem;}
  .story-copy p{font-size:.9375rem;}
}

@media (prefers-reduced-motion:reduce){
  *{transition-duration:.01ms !important;animation-duration:.01ms !important;animation-iteration-count:1 !important;}
  .summary .mascot--bar{opacity:1;transform:none;}
  .summary{transform:translateY(0);}
  .timer{animation:none;}
  .timer .prog{transition:none;}
}

/* ============================================================
   ÚPRAVY PROTOTYPU — kompaktní produkty, detail a košík
   ============================================================ */
.section-head{display:none;}
.story{display:none;}
.tip .mascot--tip{display:none;}
.tip-paw{
  flex:0 0 auto;
  width:42px;height:42px;
  padding:9px;
  border-radius:50%;
  background:#fff;
  color:var(--magenta);
}
.grid{margin-top:var(--s6);}
.item{
  padding:10px;
  border:1px solid #D8CDE7;
  border-radius:var(--r-sm);
  box-shadow:0 2px 7px rgba(30,23,38,.045);
}
.item:hover{border-color:var(--violet);box-shadow:0 5px 14px rgba(107,67,206,.12);}
.thumb{
  padding:0;
  border:0;
  border-radius:6px;
  cursor:zoom-in;
  transition:transform .18s ease,box-shadow .18s ease;
}
.thumb:hover{transform:scale(.985);box-shadow:0 0 0 3px var(--violet-tint);}
.item-body{padding:8px 2px 10px;}
.reason{display:none;}
.name{
  margin:0;
  font-size:.9375rem;
  line-height:1.28;
  min-height:0;
}
.prices{margin-top:2px;gap:0 7px;}
.price{font-size:1.1rem;color:var(--ink);}
.price-old{font-size:.8rem;color:var(--magenta);}
.add,.add[aria-pressed="true"]{
  background:var(--grad-add);
  border-radius:999px;
  border:0;
}
.cta{background:var(--grad-cta);}
.add[aria-pressed="true"]{
  color:#fff;
  border:0;
  padding:7px var(--s2);
}

/* Detail produktu */
.product-modal{max-width:520px;text-align:left;padding:var(--s4);}
.product-modal .modal-x{top:12px;right:12px;background:rgba(255,255,255,.88);z-index:1;}
.product-detail-img{
  width:100%;aspect-ratio:4/3;object-fit:cover;
  border-radius:var(--r-sm);background:#F3F0F7;
}
.product-detail-copy{padding:var(--s4) var(--s2) var(--s2);}
.product-detail-copy h2{margin:0;font-size:1.35rem;line-height:1.2;padding-right:28px;}
.product-detail-copy p{margin:var(--s2) 0 0;color:var(--ink-muted);}
.product-detail-copy .prices{margin-top:var(--s4);}
.product-detail-copy .price{font-size:1.4rem;color:var(--ink);}
.product-detail-copy .price-old{font-size:.9rem;color:var(--magenta);}
.product-detail-copy .modal-close{margin-top:var(--s4);background:var(--grad-add);color:#fff;}

/* Sticky lišta: Levandulka je uvnitř lišty, ne nad produkty. */
.summary .mascot--bar{
  display:none;
}
.summary-paw{
  order:3;
  flex:0 0 auto;
  width:54px;height:54px;
  padding:11px;
  color:var(--magenta);
  background:var(--violet-tint);
  border-radius:50%;
}
.summary .mascot--bar{
  display:block;
}
.summary-paw{display:none;}
.summary .mascot--bar{
  position:static;
  order:3;
  flex:0 0 auto;
  width:96px;
  height:68px;
  object-fit:contain;
  opacity:1;
  transform:none;
  pointer-events:none;
}
.summary[data-state="filled"] .mascot--bar{
  animation:cat-fly .75s cubic-bezier(.34,1.56,.64,1) both,
             cat-float 3.2s .75s ease-in-out infinite;
}
.summary-top{min-height:76px;}
.summary-top .timer{width:112px;height:112px;order:1;}
.summary-top .timer svg.ring{width:112px;height:112px;}
.timer-face .clock{font-size:1.45rem;}
.timer-face .paw{width:28px;height:28px;}
.summary-note{order:2;}
.summary-note strong{font-size:1rem;}
.summary-note span{font-size:.8125rem;}
.total{order:4;}
.cta{border-radius:999px;order:5;margin-left:var(--s4);}
.summary-toggle{
  position:absolute;top:-14px;left:50%;z-index:2;
  width:auto;height:42px;display:flex;align-items:center;gap:8px;
  transform:translateX(-50%);
  padding:7px 16px;
  background:var(--surface);border:0;
  border-radius:999px;color:var(--violet);
  cursor:pointer;box-shadow:0 2px 8px rgba(30,23,38,.1);
  white-space:nowrap;font-size:1rem;font-weight:400;
}
.summary-toggle svg{width:21px;height:21px;transform:rotate(-90deg);transition:transform .16s cubic-bezier(.22,1,.36,1);}
.summary.is-expanded .summary-toggle svg{transform:rotate(90deg);}
.summary-toggle[hidden]{display:none;}
.summary[data-state="empty"] .summary-note{text-align:center;}
.summary[data-state="empty"] .summary-note strong{font-size:1.05rem;}
.cart-panel{
  display:grid;
  grid-template-rows:0fr;
  width:min(100%,560px);
  margin:0 auto;
  transition:grid-template-rows .3s cubic-bezier(.22,1,.36,1);
}
.summary.is-expanded .cart-panel{grid-template-rows:1fr;margin-top:var(--s3);}
.cart-panel-body{
  overflow:hidden;min-height:0;
  padding:10px;
  background:linear-gradient(180deg,#FBF9FE 0%,#F7F1FC 100%);
  border:1px solid var(--line);
  border-radius:14px;
  opacity:0;
  transition:opacity .2s ease;
}
.summary.is-expanded .cart-panel-body{opacity:1;transition:opacity .22s ease .08s;}
.summary.is-expanded .cart-row{animation:cart-row-in .18s cubic-bezier(.22,1,.36,1) both;}
.summary.is-expanded .cart-row:nth-child(2){animation-delay:.03s;}
.summary.is-expanded .cart-row:nth-child(3){animation-delay:.06s;}
.summary.is-expanded .cart-row:nth-child(4){animation-delay:.09s;}
.summary.is-expanded .cart-row:nth-child(n+5){animation-delay:.12s;}
@keyframes cart-row-in{from{opacity:0;transform:translateY(-8px)}to{opacity:1;transform:none}}
.cart-panel-head{display:flex;justify-content:space-between;gap:var(--s3);margin-bottom:var(--s2);font-size:.8125rem;color:var(--ink-muted);}
.cart-panel-head strong{color:var(--ink);}
.cart-items{display:grid;gap:var(--s2);}
.cart-row{
  display:flex;align-items:center;gap:var(--s2);min-width:0;
  padding:6px 7px;
  background:#fff;border:1px solid var(--line-soft);
  border-radius:10px;
  box-shadow:0 1px 3px rgba(30,23,38,.04);
}
.cart-row img{width:38px;height:38px;object-fit:cover;border-radius:8px;background:#F3F0F7;}
.cart-row-name{flex:1;min-width:0;font-size:.8125rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.qty-controls{
  display:flex;align-items:center;gap:2px;flex:0 0 auto;
  padding:3px;background:var(--violet-tint);border-radius:999px;
}
.qty-controls button{
  width:28px;height:28px;display:grid;place-items:center;
  border:0;border-radius:50%;
  background:#fff;color:var(--violet);cursor:pointer;font-weight:500;
  box-shadow:0 1px 3px rgba(107,67,206,.13);
  transition:transform .15s ease,background .15s ease;
}
.qty-controls button:hover{background:#fff;transform:scale(1.08);}
.qty-controls strong{min-width:22px;text-align:center;font-size:.8125rem;color:var(--violet);}
.add{display:flex;align-items:center;justify-content:center;gap:6px;}
.add-count{
  min-width:20px;height:20px;display:inline-grid;place-items:center;
  padding:0 5px;border-radius:999px;background:rgba(255,255,255,.22);
  font-size:.7rem;line-height:1;
}
.add,.add[aria-pressed="true"]{height:40px;min-height:40px;padding:7px var(--s2);}

@media (max-width:699px){
  .summary{padding-top:var(--s4);}
  .summary-toggle{top:-38px;}
  .summary-top{gap:var(--s2);}
  .summary-top .timer{width:96px;height:96px;}
  .summary-top .timer svg.ring{width:96px;height:96px;}
  .summary .mascot--bar{width:88px;height:68px;}
  .summary-note strong{font-size:.9rem;}
  .summary-note span{font-size:.75rem;}
  .total strong{font-size:1.35rem;}
}

@media (min-width:1024px){
  .summary .mascot--bar{width:128px;height:76px;top:auto;left:auto;}
  .summary-top{gap:var(--s4);}
  .summary-inner{flex-wrap:wrap;}
  .cart-panel{flex-basis:100%;}
  .add,.add[aria-pressed="true"]{height:44px;min-height:44px;padding:var(--s3) var(--s4);}
}

/* Jemné mikroanimace — jen tam, kde podporují orientaci a kliknutí */
.tip-paw{transition:transform .22s ease,background .22s ease;}
.tip:hover .tip-paw{transform:rotate(-8deg) scale(1.06);background:#fff;}
.item{
  transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease;
}
.item:hover{transform:translateY(-2px);}
.add,.cta{transition:filter .18s ease,box-shadow .18s ease;}
.summary-toggle,.qty-controls button{
  transition:transform .18s ease,filter .18s ease,box-shadow .18s ease;
}
.add:active,.cta:active,.summary-toggle:active{transform:scale(.97);}
.summary-toggle:hover{transform:translateX(-50%) translateY(-2px);box-shadow:0 4px 12px rgba(30,23,38,.14);}
.summary-toggle:active{transform:translateX(-50%) scale(.97);}
.backdrop:not([hidden]){animation:backdrop-in .2s ease both;}
.backdrop:not([hidden]) .modal{animation:modal-in .28s cubic-bezier(.22,1,.36,1) both;}
.cart-row{animation:row-in .24s ease both;}
.cart-row:nth-child(2){animation-delay:.035s;}
.cart-row:nth-child(3){animation-delay:.07s;}
.cart-row:nth-child(4){animation-delay:.105s;}
@keyframes backdrop-in{from{opacity:0}to{opacity:1}}
@keyframes modal-in{from{opacity:0;transform:translateY(10px) scale(.98)}to{opacity:1;transform:none}}
@keyframes row-in{from{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:none}}

@media (prefers-reduced-motion:reduce){
  .confirm,.tip,.item,.backdrop:not([hidden]),.backdrop:not([hidden]) .modal,.cart-row{
    animation:none !important;
  }
  .tip:hover,.item:hover,.add:hover,.cta:hover,.summary-toggle:hover{
    transform:none !important;
  }
}

