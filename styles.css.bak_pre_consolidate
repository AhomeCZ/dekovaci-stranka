/* Maskot je součástí sticky souhrnu — nic nepřesahuje nad lištu ani do produktů. */
.summary .cat-fx{
  position:relative;
  right:auto;
  bottom:auto;
  flex:0 0 80px;
  width:80px;
  height:68px;
  margin:0;
  margin-left:auto;
  align-self:center;
  order:5;
  overflow:hidden;
  border-radius:12px;
  pointer-events:none;
  z-index:0;
}
.summary .cat-fx .mascot--bar{
  position:relative;
  top:auto;
  right:auto;
  bottom:auto;
  left:auto;
  display:block;
  width:100% !important;
  height:100% !important;
  object-fit:contain;
  object-position:center;
}
.summary .cat-fx .cat-line{
  display:none;
}

/* gradient-1 ▸ jiná sada maskotů (uši jsou široký asset, ne čtverec) */
html[data-palette="custom"][data-art="1"] .tip{padding-right:10px;}
html[data-palette="custom"][data-art="1"] .tip .mascot--tip{
