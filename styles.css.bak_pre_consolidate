/* ============================================================
   TWEAKS — tři výrazové režimy (maskot / naléhavost / hustota)
   ============================================================ */
/* 1 ▸ NÁLADA MASKOTA */
html[data-mascot="klid"] .cat-fx{width:120px;filter:drop-shadow(0 4px 12px rgba(138,103,183,.22));}
html[data-mascot="klid"] .cat-fx .cat-line{display:none;}
html[data-mascot="klid"] .summary .mascot--bar{animation-duration:5.2s;}
html[data-mascot="klid"] .tip .mascot--tip{animation-duration:7s;}
@media (min-width:640px){ html[data-mascot="klid"] .cat-fx{width:150px;} }
@media (min-width:1024px){ html[data-mascot="klid"] .cat-fx{width:180px;} }

html[data-mascot="super"] .cat-fx{width:170px;filter:drop-shadow(0 10px 26px rgba(138,103,183,.45)) drop-shadow(0 3px 6px rgba(43,37,48,.16));}
html[data-mascot="super"] .summary .mascot--bar{animation-duration:1.9s;}
html[data-mascot="super"] .cat-fx .cat-line{animation-duration:1.1s;height:8px;}
html[data-mascot="super"] .tip .mascot--tip{animation-duration:2.4s;}
html[data-mascot="super"] .tip-watermark{opacity:.16;}
@media (min-width:640px){ html[data-mascot="super"] .cat-fx{width:260px;} }
@media (min-width:1024px){ html[data-mascot="super"] .cat-fx{width:320px;right:-30px;} }

/* 2 ▸ NALÉHAVOST ODPOČTU */
html[data-urgency="klid"] .timer{animation:none;}
html[data-urgency="klid"] .timer .prog{stroke:var(--violet);}
html[data-urgency="klid"] .timer-face .clock,html[data-urgency="klid"] .timer-face .paw{color:var(--violet);}
html[data-urgency="klid"] .summary-note strong{font-weight:600;}
html[data-urgency="klid"] .total strong{color:var(--ink);}

html[data-urgency="spech"] .timer{animation:tick 1s steps(1,end) infinite,urgent-pulse 1.6s ease-in-out infinite;}
html[data-urgency="spech"] .timer .prog{stroke:var(--magenta);stroke-width:6;}
html[data-urgency="spech"] .timer-face .clock{font-size:1.6rem;}
html[data-urgency="spech"] .summary-inner{box-shadow:0 -3px 22px rgba(201,107,145,.26);}
html[data-urgency="spech"] .summary-note strong{color:var(--magenta);}
@keyframes urgent-pulse{50%{transform:scale(1.06);}}

/* 3 ▸ HUSTOTA NABÍDKY */
html[data-density="vzdusna"] .grid{gap:20px;margin-top:22px;}
html[data-density="vzdusna"] .item{padding:14px;border-radius:18px;}
