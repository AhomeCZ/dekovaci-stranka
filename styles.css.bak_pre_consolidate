html[data-density="huste"] .grid{gap:7px;margin-top:10px;}
html[data-density="huste"] .item{padding:6px;border-radius:11px;}
html[data-density="huste"] .thumb{aspect-ratio:1.25;}
html[data-density="huste"] .item-body{padding:6px 2px 5px;}
html[data-density="huste"] .tip{padding:8px 16px 8px 10px;}


