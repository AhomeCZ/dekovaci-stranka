/* Drobné popisky byly nečitelné — o stupeň nahoru. */
@media (max-width:639px){
  .confirm-contact{font-size:.88rem;gap:2px 10px;}
  .confirm-contact dd{color:var(--ink-muted);}

  .tip{padding:8px 10px 8px 4px;gap:6px;}
  html[data-palette="custom"][data-art="1"] .tip .mascot--tip{width:48px;margin-bottom:-6px;}
  .tip-copy strong{font-size:1.06rem;}
  .tip-copy span{font-size:.9rem;}

  .summary[data-state="filled"] .total span{font-size:.85rem;}

  .cart-panel-head{font-size:.9rem;}
  .cart-panel-head strong{font-size:.95rem;}
  .cart-row-name{font-size:.95rem;}
}

@media (max-width:379px){
  .tip-copy strong{font-size:1rem;}
  .tip-copy span{font-size:.84rem;}
}
@media (max-width:345px){
  .tip-copy strong{font-size:.94rem;}
  .tip-copy span{font-size:.74rem;}
  .confirm-contact{font-size:.8rem;}
}

/* Potvrzení má být dvouřádkové: stav + tužka, pod tím oba kontakty vedle sebe. */
.confirm-contact{
  display:flex;
  flex-wrap:nowrap;
  align-items:baseline;
  gap:0 7px;
  min-width:0;
  overflow:hidden;
}
.confirm-contact dt{
  flex:0 0 auto;
  color:var(--ink-faint);
}
.confirm-contact dt + dd{
  flex:0 1 auto;
  min-width:0;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
/* Oddělovač mezi e-mailem a telefonem. */
.confirm-contact dd + dt::before{
  content:"·";
  margin-right:7px;
  color:var(--ink-faint);
}
.confirm-contact dd:last-child{flex:0 0 auto;}
@media (max-width:639px){
  .confirm-contact{font-size:.82rem;gap:0 6px;}
  .confirm-contact dd + dt::before{margin-right:6px;}
}
@media (max-width:379px){
  .confirm-contact{font-size:.76rem;}
}

/* Na mobilu se popisky vynechají — e-mail a číslo se poznají samy
   a celá adresa je důležitější než slovo „E-mail“ před ní. */
@media (max-width:639px){
  .confirm-contact dt{display:none;}
  .confirm-contact dd:last-child::before{
    content:"·";
    margin-right:6px;
    color:var(--ink-faint);
  }
  .confirm-contact dd:last-child{flex:0 0 auto;}
  .confirm-contact{font-size:.86rem;}
}
@media (max-width:379px){
  .confirm-contact{font-size:.78rem;}
}
@media (max-width:345px){
  .confirm-contact{font-size:.72rem;}
}

/* Prázdná lišta ať trochu dýchá — víc odsazení nahoře i dole. */
@media (max-width:639px){
  .summary[data-state="empty"] .summary-inner{
    padding:16px 14px calc(16px + env(safe-area-inset-bottom));
  }
  .summary[data-state="empty"] .summary-note strong{line-height:1.35;}
  .summary[data-state="empty"] .summary-note span{margin-top:2px;}
}
@media (max-width:345px){
  .summary[data-state="empty"] .summary-inner{
    padding:14px 12px calc(14px + env(safe-area-inset-bottom));
  }
}

/* Kratší nadpis uvolnil místo — kočka se vrací i na běžné telefony. */
@media (min-width:360px) and (max-width:639px){
  .summary[data-state="empty"] .cat-fx{
    display:block;flex-basis:52px;width:52px;height:44px;
  }
}

/* ============================================================
   JEDNOTNÉ MĚŘÍTKO NA MOBILU
   Dvě velikosti místo tuctu: 1rem nese hlavní sdělení,
   0.9rem všechno doplňkové. Pod 360 px se obojí sníží o stupeň.
   ============================================================ */
@media (max-width:639px){
  /* --- hlavní řádky --- */
  .confirm h1,
  .summary[data-state="empty"] .summary-note strong,
  .tip-copy strong,
  .name,
  .add,
  .cart-panel-head strong{font-size: 0.85rem;}

  /* --- doplňkové řádky --- */
  .confirm-contact,
  .summary[data-state="empty"] .summary-note span,
  .tip-copy span,
  .summary[data-state="filled"] .total span,
  .cart-panel-head,
  .cart-panel-head span,
  .cart-row-name,
  .section-head p{font-size: .74rem;}

  .section-head h2{font-size:1.25rem;}

  /* Uši a kočka ustupují, aby se jednotné písmo vešlo. */
  html[data-palette="custom"][data-art="1"] .tip .mascot--tip{width:44px;}
  .summary[data-state="empty"] .cat-fx{display:none;}
}

@media (min-width:380px) and (max-width:639px){
  .summary[data-state="empty"] .cat-fx{
    display:block;flex-basis:52px;width:52px;height:44px;
  }
}

/* Jeden stupeň dolů pro úzké telefony — pořád jen dvě velikosti. */
@media (max-width:359px){
  .confirm h1,
  .summary[data-state="empty"] .summary-note strong,
  .tip-copy strong,
  .name,
  .add,
  .cart-panel-head strong{font-size:.9rem;}

  .confirm-contact,
  .summary[data-state="empty"] .summary-note span,
  .tip-copy span,
  .summary[data-state="filled"] .total span,
  .cart-panel-head,
  .cart-panel-head span,
  .cart-row-name,
  .section-head p{font-size:.82rem;}

  .section-head h2{font-size:1.12rem;}
}

@media (max-width:359px){
  .tip{padding:8px 8px 8px 2px;gap:5px;}
  html[data-palette="custom"][data-art="1"] .tip .mascot--tip{width:30px;margin-bottom:-4px;}
}

/* ============================================================
   KARTA PRODUKTU — ceny nad sebou, košík jako ikona
   ============================================================ */
.item{
  display:grid;
  grid-template-columns:1fr auto;
  grid-template-areas:
    "thumb thumb"
    "body  body"
    "price add";
  align-items:end;
  gap:0;
}
.item .thumb{grid-area:thumb;}
.item-body{grid-area:body;padding:8px 2px 0;}
.item .prices{grid-area:price;}
.item .add{grid-area:add;}

/* Stará cena nahoře, aktuální pod ní a výrazně větší. */
.prices{
  display:flex;
  flex-direction:column;
  align-items:flex-start;
  gap:0;
  margin-top:6px;
  min-width:0;
}
.price-old{order:1;line-height:1.2;}
.price{order:2;line-height:1.15;}

/* Bílá ikona na gradientu — plocha zůstává, text zmizel. */
.add{
  width:auto !important;
  min-width:46px;
  height:46px !important;
  min-height:46px !important;
  margin:6px 0 0 !important;
  padding:0 !important;
  display:inline-flex;align-items:center;justify-content:center;gap:5px;
  background:var(--grad-cta);
  border:0 !important;
  color:#fff !important;
  box-shadow:0 3px 10px rgba(58,52,54,.16);
}
.add:hover{background:var(--grad-cta);filter:brightness(1.05);}
.add[aria-pressed="true"]{
  background:var(--grad-cta);
  color:#fff !important;
  padding:0 12px 0 10px !important;
}
.add-icon{width:22px;height:22px;flex:0 0 auto;}
.add-count{
  min-width:20px;height:20px;
  display:inline-grid;place-items:center;
  padding:0 5px;border-radius:999px;
  background:rgba(255,255,255,.26) !important;
  color:#fff;font-size:.78rem;font-weight:700;line-height:1;
}

@media (max-width:359px){
  .add{min-width:42px;height:42px !important;min-height:42px !important;}
  .add-icon{width:20px;height:20px;}
}

/* Ceny jsou teď samostatná buňka mřížky, ne obsah těla karty —
   tím zmizel prázdný pás vedle tlačítka. */
.item{padding:6px;row-gap:0;column-gap:8px;}
.item-body{padding:7px 2px 0;}
.name{margin:0;}
.prices{margin-top:5px;align-self:end;}
.price-old{font-size:.8rem;}
.add{margin:0 !important;align-self:end;}

/* Ceny a košík drží při sobě: cenový sloupec je jen tak široký,
   jak potřebuje, tlačítko dobere zbytek. */
.item{grid-template-columns:auto 1fr;column-gap:8px;}
.prices{justify-self:start;}
.add{
  justify-self:stretch;
  width:100% !important;
  min-width:0;
  padding:0 10px !important;
}
.add[aria-pressed="true"]{padding:0 10px !important;}


/* ============================================================
   AHOME — vizuální styl podle stylového průvodce
   Barvy: švestková fialová, magenta, lila, levandulový papír, šalvěj
   Typografie: Poppins (nadpisy, ceny, CTA i běžný text)
   Tvary: větší radiusy, měkké stíny, pilulková tlačítka s gradientem
   ============================================================ */
html,
html[data-palette],
html[data-palette="levandule"],
html[data-palette="custom"]{
  --bg:#F7F2FA;
  --surface:#FFFFFF;
  --ink:#2A2233;
  --ink-muted:#6E6478;
  --ink-faint:#9C93A6;
  --violet:#7B3A96;
  --violet-dark:#5C2A73;
  --violet-tint:#F3EAF8;
  --lila:#E7C9E8;
  --magenta:#D6297D;
  --sage:#7E8B5F;
  --green:#5E7A46;
  --green-tint:#F1F5EC;
  --line:#EBE0F0;
  --line-soft:#F5EFF8;
  --palette-confirm:#F1F5EC;
  --palette-confirm-line:#DCE5D0;
  --palette-confirm-ink:#4E6A3A;

  --grad-add:linear-gradient(135deg,#A98BD6 0%,#BE86D0 40%,#EE7FAF 100%);
  --grad-cta:linear-gradient(90deg,#8B3FA8 0%,#B93B9C 45%,#E52E80 100%);

  --r-sm:10px; --r-md:16px; --r-lg:20px; --r-tile:12px; --r-pill:999px;
  --shadow:0 2px 12px rgba(90,45,120,.06);
}

body{
  font-family:'Poppins',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
  background:var(--bg);
  letter-spacing:0;
}

/* --- Poppins v silnějším řezu: nadpisy, ceny, časovač, CTA --- */
.confirm h1,
.section-head h2,
.tip-copy strong,
.summary-note strong,
.story-copy h3,
.faq-copy strong,
.price,
.total strong,
.cta,
.timer-face .clock,
.cart-panel-head strong,
.modal h2,.modal h3{
  font-family:'Poppins',system-ui,sans-serif;
  font-weight:600;
  letter-spacing:-.01em;
  font-variation-settings:normal;
}
.confirm h1{font-size:1.25rem;line-height:1.3;}
.section-head h2{font-size:1.35rem;line-height:1.25;}
.tip-copy strong{font-size:1.15rem;}
.price{font-weight:600;color:var(--ink);}
.price-old{color:var(--ink-faint);text-decoration:line-through;}
.total strong{color:var(--magenta);}

/* --- Potvrzení objednávky: bílá karta se šalvějovým proužkem --- */
.confirm{
  background:var(--surface);
  border:1px solid var(--line);
  border-left:4px solid var(--sage);
  border-radius:var(--r-lg);
  box-shadow:var(--shadow);
}
.confirm-contact dd{color:var(--ink-muted);}
.icon-btn{border-radius:var(--r-pill);border:1px solid var(--line);background:var(--violet-tint);color:var(--violet);}
.icon-btn:hover{background:var(--lila);border-color:var(--lila);color:var(--violet-dark);}

/* --- Tip: levandulová karta --- */
.tip{
  background: #F6F2F9 !important;
  border:1px solid var(--line);
  border-radius:var(--r-lg);
  box-shadow:none;
}
.tip:hover{background:var(--lila);}
.tip-paw,.chev{color:var(--magenta);}
.tile{background:var(--lila);color:var(--violet-dark);border-radius:var(--r-tile);}

/* --- Karta produktu --- */
.item{
  background:var(--surface);
  border:1px solid var(--line);
  border-radius:var(--r-lg);
  box-shadow:var(--shadow);
  overflow:hidden;
  transition:box-shadow .18s ease,border-color .18s ease;
}
.item:hover{border-color:var(--lila);box-shadow:0 6px 18px rgba(90,45,120,.10);}
.thumb{border-radius:var(--r-md);background:var(--line-soft);}
.thumb:hover{box-shadow:0 0 0 3px var(--violet-tint);}
.name{color:var(--ink);}

/* --- Tlačítko do košíku: gradient, po přidání obrys v magentě --- */
.add{
  background:var(--grad-add);
  color:#fff;
  border:1px solid transparent;
  border-radius:var(--r-pill);
  box-shadow:0 2px 8px rgba(214,41,125,.18);
}
.add:hover{filter:brightness(1.05);box-shadow:0 4px 14px rgba(214,41,125,.26);}
.add[aria-pressed="true"]{
  background:var(--surface);
  border:1.5px solid var(--magenta);
  color:var(--magenta);
  box-shadow:none;
}
.add-count{background:var(--magenta);color:#fff;}

/* --- Příběh, FAQ --- */
.story,.faq{
  background:var(--surface);
  border:1px solid var(--line);
  border-radius:var(--r-lg);
  box-shadow:var(--shadow);
  overflow:hidden;
}
.faq:hover{border-color:var(--lila);}

/* --- Spodní lišta + hlavní CTA --- */
.summary{
  background:rgba(255,255,255,.96);
  backdrop-filter:blur(10px);
  border-top:1px solid var(--line);
  box-shadow:0 -6px 24px rgba(90,45,120,.10);
}
.cta{
  background:var(--grad-cta);
  color:#fff;
  border:none;
  border-radius:var(--r-pill);
  font-weight:600;
  box-shadow:0 4px 16px rgba(214,41,125,.28);
}
.cta:hover{filter:brightness(1.06);box-shadow:0 6px 20px rgba(214,41,125,.34);}
.summary-toggle{border-radius:var(--r-pill);border:1px solid var(--line);color:var(--violet);}
.timer-face .clock,.timer-face .paw{color:var(--magenta);}
.timer .track{stroke:var(--line);}

/* --- Košík v liště --- */
.cart-row{background:var(--line-soft);border-radius:var(--r-md);}
.cart-row img{border-radius:10px;}
.qty-controls button{border-radius:var(--r-pill);border:1px solid var(--line);background:#fff;color:var(--violet);}
.qty-controls button:hover{border-color:var(--magenta);color:var(--magenta);}

/* --- Modály --- */
.modal{border-radius:var(--r-lg);box-shadow:0 18px 48px rgba(60,25,80,.22);}
.modal-x{border-radius:var(--r-pill);}
.modal-close{border-radius:var(--r-pill);}
.product-detail-copy .modal-close{background:var(--grad-cta);color:#fff;border:none;}

/* --- Formulářové prvky --- */
.mail-edit input{border-radius:var(--r-md);border:1px solid var(--line);background:#fff;}
.btn-solid{background:var(--grad-cta);border:none;border-radius:var(--r-pill);color:#fff;}
.btn-solid:hover{filter:brightness(1.06);background:var(--grad-cta);}
.btn-ghost{border-radius:var(--r-pill);}

:focus-visible{outline:2px solid var(--magenta);outline-offset:2px;}



/* ============================================================
   AHOME — karta produktu: cena vlevo, tlačítko vpravo,
   měkčí zaoblení všude
   ============================================================ */
html,
html[data-palette],
html[data-palette="levandule"],
html[data-palette="custom"]{
  --r-sm:14px; --r-md:20px; --r-lg:26px; --r-tile:16px;
  --r-card:26px;
}

.item{
  border-radius:26px;
  padding:8px;
  grid-template-columns:1fr 1fr;
  column-gap:8px;
}
.thumb{border-radius:20px;}
.tip,.story,.faq,.confirm{border-radius:26px;}
.modal{border-radius:28px;}
.mail-edit input{border-radius:18px;}
.cart-row{border-radius:18px;}
.cart-row img{border-radius:14px;}
.tile{border-radius:16px;}

/* Cena drží levou polovinu, tlačítko pravou. */
.item .prices{justify-self:stretch;min-width:0;}
.item .add,
.item .add[aria-pressed="true"]{
  justify-self:stretch;
  width:100% !important;
  min-width:0;
  padding:0 10px !important;
  gap:6px;
  border-radius:999px;
  font-family:'Poppins',system-ui,sans-serif;
  font-size:.82rem;
  font-weight:600;
}
.add-label{
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}
.add-icon{width:19px;height:19px;}

@media (max-width:420px){
  .item .add,.item .add[aria-pressed="true"]{font-size:.76rem;padding:0 8px !important;gap:4px;}
  .add-icon{width:17px;height:17px;}
}
@media (max-width:359px){
  .item .add .add-icon{display:none;}
}



/* ============================================================
   AHOME — kompaktní hlavička stránky
   Potvrzení, tip i mezery drží co nejmenší výšku,
   aby se nad ohyb vešlo víc produktů.
   ============================================================ */
.page{padding-top:10px;}

.confirm{padding:7px 10px 8px;}
.confirm h1{font-size:.95rem;}
.confirm-contact{margin-top:3px;font-size:.78rem;line-height:1.3;}
.confirm-head .icon-btn{width:28px;height:28px;}
.confirm-head .icon-btn svg{width:16px;height:16px;}

/* Od 560 px se vejde potvrzení i kontakty na jeden řádek. */
@media (min-width:560px){
  .confirm{
    display:flex;flex-wrap:wrap;align-items:center;gap:4px 10px;
    padding:6px 10px 6px 12px;
  }
  .confirm-head{display:contents;}
  .confirm h1{flex:0 0 auto;font-size:.95rem;}
  .confirm-contact{
    flex:1 1 auto;min-width:0;
    display:flex;flex-wrap:wrap;align-items:baseline;gap:0 8px;
    margin:0;padding-left:0;
  }
  .confirm-contact dd{margin-right:6px;}
  .confirm-head .icon-btn{order:5;margin-left:auto;}
  .mail-edit{flex:1 1 100%;padding-left:0;margin-top:6px;}
}

/* Tip a nadpis sekce: méně vzduchu, víc karet. */
.tip{padding:7px 10px;margin-top:8px;}
.tip-copy strong{font-size:1rem;line-height:1.25;}
.tip-copy span{font-size:.8rem;line-height:1.3;}
.section-head{margin-top:14px;}
.section-head h2{font-size:1.15rem;}
.section-head p{margin-top:2px;font-size:.8rem;}
.grid{margin-top:10px;gap:8px;}

/* Karta: kratší tělo, ale čitelné. */
.item{padding:7px;}
.item-body{padding:6px 2px 0;}
.name{font-size:.88rem;line-height:1.28;}
.prices{margin-top:3px;}
.price{font-size:1.02rem;}
.price-old{font-size:.74rem;}
.item .add,.item .add[aria-pressed="true"]{
  height:38px !important;min-height:38px !important;margin-top:4px !important;
}
.story{margin-top:14px;}



/* ============================================================
   AHOME — karta: tlačítko přes celou šířku, ceny na jeden řádek
   Půlka na půlku se na mobilu nevešla („Do ..."), proto má
   tlačítko vlastní řádek — text je vždy celý.
   ============================================================ */
.grid{gap:8px;}
.item{
  grid-template-columns:minmax(0,1fr);
  grid-template-areas:
    "thumb"
    "body"
    "price"
    "add";
  padding:7px;
  row-gap:0;
}

/* Aktuální cena první, přeškrtnutá vedle ní — ušetří řádek. */
.prices{
  flex-direction:row;
  flex-wrap:wrap;
  align-items:baseline;
  gap:0 7px;
  margin-top:4px;
  padding:0 2px;
}
.price{order:1;font-size:1.05rem;}
.price-old{order:2;font-size:.76rem;}

.item .add,
.item .add[aria-pressed="true"]{
  width:100% !important;
  height:36px !important;min-height:36px !important;
  margin:6px 0 0 !important;
  padding:0 10px !important;
  gap:6px;
  font-size:.85rem;
  border-radius:999px;
}
.add-label{
  overflow:visible;
  text-overflow:clip;
  white-space:nowrap;
}
.item .add .add-icon{display:inline-block;width:17px;height:17px;}

@media (max-width:380px){
  .grid{gap:7px;}
  .item{padding:6px;}
  .name{font-size:.85rem;}
  .item .add,.item .add[aria-pressed="true"]{font-size:.8rem;height:34px !important;min-height:34px !important;}
}



/* Upsell, ne klasický nákup — plus + „Přidat" místo „Do košíku". */
.item .add .add-icon{width:15px;height:15px;}
.item .add,.item .add[aria-pressed="true"]{gap:5px;letter-spacing:.005em;}



/* ============================================================
   GRADIENT — zadané stopy: #B27EDB 0 %, #C454B9 50 %, #EE729D 100 %
   ============================================================ */
html,
html[data-palette],
html[data-palette="levandule"],
html[data-palette="custom"]{
  --grad-add:linear-gradient(135deg,#B27EDB 0%,#C454B9 50%,#EE729D 100%);
  --grad-cta:linear-gradient(90deg,#B27EDB 0%,#C454B9 50%,#EE729D 100%);
}
.item .add,
.item .add[aria-pressed="true"],
.item .add:hover{background:var(--grad-add);}
.cta,.btn-solid,.product-detail-copy .modal-close{background:var(--grad-cta);}
.item .add{box-shadow:0 3px 10px rgba(178,126,219,.28);}
.item .add:hover{box-shadow:0 5px 14px rgba(238,114,157,.32);}
.cta{box-shadow:0 4px 16px rgba(196,84,185,.30);}



/* ============================================================
   KARTA — spodní řádek na dvě poloviny:
   vlevo cena, vpravo tlačítko „+ Přidat"
   (krátký popisek se do poloviny vejde, na rozdíl od „Do košíku")
   ============================================================ */
.item{
  grid-template-columns:1fr 1fr;
  grid-template-areas:
    "thumb thumb"
    "body  body"
    "price add";
  align-items:end;
  column-gap:6px;
}
.item .prices{grid-area:price;}
.item .add{grid-area:add;}

/* V polovině karty je na ceny málo místa — proto pod sebe. */
.prices{
  flex-direction:column;
  align-items:flex-start;
  gap:0;
  margin-top:5px;
  padding:0 0 0 2px;
  min-width:0;
}
.price-old{order:1;font-size:.74rem;line-height:1.2;}
.price{order:2;font-size:1.02rem;line-height:1.2;}

.item .add,
.item .add[aria-pressed="true"]{
  justify-self:stretch;
  width:100% !important;
  min-width:0;
  margin:0 !important;
  padding:0 8px !important;
  height:36px !important;min-height:36px !important;
  font-size:.82rem;
  gap:4px;
}
.item .add .add-icon{width:14px;height:14px;}

@media (max-width:380px){
  .item .add,.item .add[aria-pressed="true"]{font-size:.78rem;height:34px !important;min-height:34px !important;padding:0 6px !important;}
  .price{font-size:.98rem;}
}
@media (min-width:640px){
  .item .add,.item .add[aria-pressed="true"]{height:40px !important;min-height:40px !important;font-size:.88rem;}
  .item .add .add-icon{width:16px;height:16px;}
}



/* ============================================================
   CENY + SLEVOVÝ ŠTÍTEK
   Hot pink je vlastní token, aby ho nepřepsal panel s gradientem.
   ============================================================ */
html,html[data-palette],html[data-palette="custom"]{--hot-pink:#EE3E8E;}

.prices{margin-top:5px;}
.price{font-size:1.22rem;line-height:1.15;font-weight:600;}
.price-old{
  font-size:.86rem;line-height:1.25;
  color:var(--hot-pink) !important;
  text-decoration:line-through;
  text-decoration-thickness:1.5px;
  font-weight:500;
}
@media (min-width:640px){
  .price{font-size:1.34rem;}
  .price-old{font-size:.92rem;}
}
@media (max-width:359px){
  .price{font-size:1.12rem;}
  .price-old{font-size:.8rem;}
}

/* Sleva v levém horním rohu náhledu — drobná, ať nebere pozornost fotce. */
.thumb{position:relative;}
.badge{
  position:absolute;top:6px;left:6px;
  padding:2px 7px;
  border-radius:999px;
  background:var(--hot-pink);
  color:#fff;
  font-family:'Poppins',system-ui,sans-serif;
  font-size:.66rem;font-weight:700;line-height:1.5;
  letter-spacing:.01em;
  font-variant-numeric:tabular-nums;
  box-shadow:0 2px 6px rgba(238,62,142,.28);
  pointer-events:none;
}
@media (max-width:359px){.badge{font-size:.62rem;padding:1px 6px;}}


/* ============================================================
   VĚTŠÍ TLAČÍTKA — mobil first, minimálně 44 px dotyková plocha
   ============================================================ */
.item .add,
.item .add[aria-pressed="true"]{
  height:44px !important;min-height:44px !important;
  font-size:.92rem;
  gap:6px;
  padding:0 10px !important;
  font-weight:600;
}
.item .add .add-icon{width:17px;height:17px;}
.item .add-count{min-width:20px;height:20px;font-size:.76rem;}

/* Hlavní CTA v liště je nejdůležitější akce — ať je pořádně vidět. */
.cta{
  min-height:52px;height:52px;
  font-size:1.02rem;
  padding:0 22px;
}
.summary-toggle{min-height:40px;padding:0 14px;font-size:.85rem;}
.qty-controls button{width:36px;height:36px;font-size:1rem;}
.icon-btn{width:38px;height:38px;}
.icon-btn svg{width:19px;height:19px;}
.confirm-head .icon-btn{width:38px;height:38px;}
.confirm-head .icon-btn svg{width:19px;height:19px;}
.mail-edit input{height:44px;font-size:.92rem;}
.mail-edit .btn-solid,.mail-edit .btn-ghost{height:40px;padding:0 18px;font-size:.88rem;}
.modal-close,.product-detail-copy .modal-close{min-height:48px;font-size:.98rem;padding:0 20px;}
.modal-x{width:40px;height:40px;}

@media (max-width:359px){
  .item .add,.item .add[aria-pressed="true"]{height:42px !important;min-height:42px !important;font-size:.85rem;padding:0 8px !important;}
  .cta{min-height:48px;height:48px;font-size:.96rem;padding:0 16px;}
}
@media (min-width:640px){
  .item .add,.item .add[aria-pressed="true"]{height:48px !important;min-height:48px !important;font-size:.98rem;}
  .item .add .add-icon{width:18px;height:18px;}
}



/* ============================================================
   POTVRZENÍ — zelené kolečko, zelený nadpis, e-mail, „Upravit údaje"
   Telefon vypuštěn, blok drží zhruba 2,5 řádku.
   ============================================================ */
.confirm{
  display:grid;
  grid-template-columns:auto minmax(0,1fr) auto;
  grid-template-areas:
    "check title edit"
    "check mail  edit"
    "form  form  form";
  align-items:center;
  column-gap:10px;
  row-gap:1px;
  padding:10px 12px;
  background:var(--surface);
  border:1px solid var(--line);
  border-left:1px solid var(--line);
  border-radius:26px;
  box-shadow:var(--shadow);
}
.confirm-check{
  grid-area:check;
  width:34px;height:34px;
  display:grid;place-items:center;
  border-radius:999px;
  background:#1E9B4C;
  box-shadow:0 0 0 5px rgba(30,155,76,.12);
}
.confirm-check svg{width:19px;height:19px;}

.confirm h1{
  grid-area:title;
  margin:0;
  font-family:'Poppins',system-ui,sans-serif;
  font-size:1.02rem;line-height:1.25;font-weight:600;
  color:#1E8A46;
  letter-spacing:-.005em;
}
.order-no{font-variant-numeric:tabular-nums;}

.confirm-mail{
  grid-area:mail;
  display:flex;align-items:center;gap:6px;
  margin:2px 0 0;
  min-width:0;
  font-size:.82rem;line-height:1.3;
  color:var(--ink-muted);
}
.confirm-mail svg{width:15px;height:15px;flex:0 0 auto;color:var(--ink-faint);}
.confirm-mail > span{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}

.edit-btn{
  grid-area:edit;
  display:inline-flex;align-items:center;justify-content:center;gap:7px;
  height:42px;padding:0 16px;
  border:1.5px solid var(--line);
  border-radius:999px;
  background:var(--surface);
  color:var(--violet);
  font-family:'Poppins',system-ui,sans-serif;
  font-size:.88rem;font-weight:500;
  cursor:pointer;
  transition:border-color .16s ease,background .16s ease;
}
.edit-btn:hover{border-color:var(--violet);background:var(--violet-tint);}
.edit-btn svg{width:18px;height:18px;flex:0 0 auto;}

.mail-edit{
  grid-area:form;
  display:grid;grid-template-columns:1fr auto auto;gap:6px;
  margin-top:8px;padding-left:0;
}
.mail-edit input{grid-column:1 / -1;}

/* Na úzkém displeji zůstane jen tužka — blok si drží výšku. */
@media (max-width:520px){
  .confirm{column-gap:9px;padding:9px 10px;}
  .confirm h1{font-size:.95rem;}
  .edit-btn{width:42px;padding:0;}
  .edit-label{display:none;}
}
@media (max-width:359px){
  .confirm-check{width:30px;height:30px;box-shadow:0 0 0 4px rgba(30,155,76,.12);}
  .confirm h1{font-size:.9rem;}
  .confirm-mail{font-size:.76rem;}
}



/* Tlačítko „+ Přidat" dýchá, slevový štítek je o něco výraznější. */
.item .add,
.item .add[aria-pressed="true"]{
  padding:0 18px !important;
  gap:7px;
}
@media (max-width:380px){
  .item .add,.item .add[aria-pressed="true"]{padding:0 12px !important;gap:5px;}
}

.badge{
  padding:4px 10px;
  font-size:.78rem;
  font-weight:700;
  top:8px;left:8px;
  box-shadow:0 2px 8px rgba(238,62,142,.32);
}
@media (max-width:359px){.badge{font-size:.72rem;padding:3px 8px;}}



/* ============================================================
   KARTA PRODUKTU — přesně podle předlohy
   Bílá karta, fotka nahoře, tučný tmavý název, přeškrtnutá cena
   hot pink nad velkou černou cenou, vpravo pastelová pilulka
   „+ Přidat". Poměry zmenšené pro dva sloupce na mobilu.
   ============================================================ */
.item{
  background:#fff;
  border:1px solid #F0EAF4;
  border-radius:22px;
  box-shadow:0 3px 14px rgba(74,44,102,.07);
  padding:8px 8px 10px;
  grid-template-columns:1fr 1fr;
  grid-template-areas:
    "thumb thumb"
    "body  body"
    "price add";
  align-items:end;
  column-gap:8px;
}
.thumb{
  grid-area:thumb;
  border-radius:14px;
  overflow:hidden;
  aspect-ratio:1 / 1;
}
.thumb img{width:100%;height:100%;object-fit:cover;}

/* Název: tmavý, polotučný, dva řádky. */
.item-body{grid-area:body;padding:9px 3px 0;}
.name{
  margin:0;
  font-family:'Poppins',system-ui,sans-serif;
  font-size:.94rem;
  font-weight:600;
  line-height:1.28;
  letter-spacing:-.005em;
  color:#231F32;
}

/* Ceny: hot pink přeškrtnutá nahoře, velká černá pod ní. */
.prices{
  grid-area:price;
  display:flex;flex-direction:column;align-items:flex-start;
  gap:0;
  margin-top:8px;
  padding-left:3px;
  min-width:0;
}
.price-old{
  order:1;
  font-family:'Poppins',system-ui,sans-serif;
  font-size:.86rem;
  font-weight:700;
  line-height:1.2;
  color:var(--hot-pink) !important;
  text-decoration:line-through;
  text-decoration-color:var(--hot-pink);
  text-decoration-thickness:2px;
}
.price{
  order:2;
  font-family:'Poppins',system-ui,sans-serif;
  font-size:1.5rem;
  font-weight:800;
  line-height:1.15;
  letter-spacing:-.02em;
  color:#141021;
  font-variant-numeric:tabular-nums;
}

/* Tlačítko: pastelová pilulka, bílý tučný text. */
.item .add,
.item .add[aria-pressed="true"]{
  grid-area:add;
  justify-self:stretch;
  width:100% !important;
  height:44px !important;min-height:44px !important;
  margin:0 !important;
  padding:0 12px !important;
  gap:5px;
  border:0 !important;
  border-radius:999px;
  background-image:linear-gradient(rgba(255,255,255,.40),rgba(255,255,255,.40)),var(--grad-add);
  color:#fff !important;
  font-family:'Poppins',system-ui,sans-serif;
  font-size:.95rem;
  font-weight:700;
  letter-spacing:-.005em;
  text-shadow:0 1px 2px rgba(120,60,140,.18);
  box-shadow:none;
}
.item .add:hover{filter:brightness(1.03);box-shadow:0 4px 12px rgba(200,140,200,.28);}
.item .add .add-icon{width:15px;height:15px;stroke-width:3;}
.item .add-count{background:rgba(255,255,255,.34) !important;color:#fff;}

@media (max-width:380px){
  .item{padding:7px 7px 9px;border-radius:20px;}
  .name{font-size:.88rem;}
  .price{font-size:1.34rem;}
  .price-old{font-size:.8rem;}
  .item .add,.item .add[aria-pressed="true"]{height:40px !important;min-height:40px !important;font-size:.88rem;padding:0 8px !important;}
}
@media (min-width:640px){
  .name{font-size:1.02rem;}
  .price{font-size:1.72rem;}
  .price-old{font-size:.95rem;}
  .item .add,.item .add[aria-pressed="true"]{height:50px !important;min-height:50px !important;font-size:1.05rem;}
  .item .add .add-icon{width:17px;height:17px;}
}



/* Potvrzení: krémové pozadí a zelenkavý rámeček. */
html .confirm,
html[data-palette] .confirm,
html[data-palette="custom"] .confirm{
  background:#FEFEFD;
  /* border-color:#CFE0C7; */
}

/* Tužka dostala popisek „Upravit" a je větší i na mobilu. */
.edit-btn{
  height:46px;
  padding:0 18px;
  gap:8px;
  font-size:.92rem;
  font-weight:600;
  border-width:1.5px;
}
.edit-btn svg{width:19px;height:19px;}
@media (max-width:520px){
  .edit-btn{width:auto;height:44px;padding:0 14px;font-size:.88rem;gap:6px;}
  .edit-label{display:inline;}
}
@media (max-width:359px){
  .edit-btn{height:42px;padding:0 12px;font-size:.82rem;}
  .edit-btn svg{width:17px;height:17px;}
}



/* ============================================================
   ÚPRAVY PODLE PŘIPOMÍNEK
   Pozadí stránky, fotka bez zaoblení dole, ceny na jeden řádek,
   na mobilu čtvercové tlačítko s košíkem.
   ============================================================ */
html,html[data-palette],html[data-palette="custom"]{--bg:#FAFAFB;}
body{background:#FAFAFB;}

/* Fotka: nahoře 9 px, dole rovná hrana. */
.thumb{border-radius:9px 9px 0 0;}
.item{padding-bottom:10px;}

/* Ceny se nikdy nelámou. */
.price,.price-old{white-space:nowrap;}
.prices{flex:0 0 auto;}

.add-cart{display:none;}

/* Mobil: tlačítko je skoro čtverec jen s košíkem, cena dostane místo. */
@media (max-width:639px){
  .item{grid-template-columns:minmax(0,1fr) auto;column-gap:8px;}
  .item .add,
  .item .add[aria-pressed="true"]{
    width:52px !important;min-width:52px;
    height:48px !important;min-height:48px !important;
    padding:0 !important;
    border-radius:14px;
    justify-self:end;
  }
  .item .add .add-icon,
  .item .add .add-label{display:none;}
  .item .add .add-cart{display:block;width:22px;height:22px;}
  .item .add-count{
    position:absolute;top:-5px;right:-5px;
    min-width:19px;height:19px;font-size:.7rem;
    background:var(--hot-pink) !important;
    box-shadow:0 0 0 2px #fff;
  }
  .item .add{position:relative;overflow:visible;}
  .price{font-size:1.42rem;}
  .price-old{font-size:.84rem;}
}
@media (max-width:359px){
  .item .add,.item .add[aria-pressed="true"]{width:46px !important;min-width:46px;height:44px !important;min-height:44px !important;border-radius:12px;}
  .item .add .add-cart{width:20px;height:20px;}
  .price{font-size:1.3rem;}
}



/* Pozadí děkovačky — přebíjí i html[data-palette] body a inline proměnnou. */
html body,
html[data-palette] body,
html[data-palette="custom"] body{background:#FAFAFB;}



/* Mňau tip — čitelnější, větší text. */
.tip{padding:10px 12px;}
.tip-copy strong{font-size:1.12rem;line-height:1.25;}
.tip-copy span{font-size:.94rem;line-height:1.35;}
@media (max-width:380px){
  .tip-copy strong{font-size:1.04rem;}
  .tip-copy span{font-size:.88rem;}
}



/* Všechna tlačítka nesou stejný gradient jako „Uložit" — bez zesvětlení. */
.item .add,
.item .add[aria-pressed="true"],
.item .add:hover,
.cta,
.btn-solid,
.product-detail-copy .modal-close,
.modal-close{
  background-image:var(--grad-cta) !important;
  background-color:transparent;
  color:#fff !important;
  border:0 !important;
  text-shadow:none;
}
.item .add{box-shadow:0 3px 10px rgba(178,126,219,.30);}
.item .add:hover,.cta:hover,.btn-solid:hover{filter:brightness(1.05);}
.item .add-count{background:rgba(255,255,255,.30) !important;}
@media (max-width:639px){
  .item .add-count{background:var(--hot-pink) !important;box-shadow:0 0 0 2px #fff;}
}



/* Zrušit vlevo, Uložit vpravo. */
.mail-edit{grid-template-columns:auto 1fr auto;}
.mail-edit .btn-ghost{grid-column:1;justify-self:start;}
.mail-edit .btn-solid{grid-column:3;justify-self:end;}

/* Počet kusů v košíku: velké dotykové +/−. */
.qty-controls{padding:5px;gap:6px;border-radius:999px;}
.qty-controls button{
  width:48px;height:48px;
  font-size:1.5rem;font-weight:600;line-height:1;
  border-radius:999px;
  border:1.5px solid var(--line);
  background:#fff;
  color:var(--violet);
}
.qty-controls button:hover{border-color:var(--magenta);color:var(--magenta);background:#fff;}
.qty-controls strong{min-width:38px;font-size:1.2rem;font-variant-numeric:tabular-nums;}
@media (max-width:359px){
  .qty-controls button{width:44px;height:44px;font-size:1.35rem;}
  .qty-controls strong{min-width:32px;font-size:1.08rem;}
}



/* Editace e-mailu na jeden řádek: Zrušit — pole — Uložit. */
.mail-edit{
  display:grid;
  grid-template-columns:auto minmax(0,1fr) auto;
  align-items:center;
  gap:8px;
  margin-top:8px;
}
.mail-edit .btn-ghost{grid-column:1;grid-row:1;justify-self:start;height:44px;padding:0 14px;font-size:.88rem;}
.mail-edit input{grid-column:2;grid-row:1;width:100%;min-width:0;height:44px;font-size:.92rem;}
.mail-edit .btn-solid{grid-column:3;grid-row:1;justify-self:end;height:44px;padding:0 18px;font-size:.9rem;font-weight:600;}
@media (max-width:359px){
  .mail-edit{gap:6px;}
  .mail-edit .btn-ghost{padding:0 10px;font-size:.82rem;}
  .mail-edit .btn-solid{padding:0 13px;font-size:.85rem;}
}



/* Detail produktu: fotka na celou šířku modálu, zaoblená jen nahoře. */
.product-modal{padding:0;overflow:hidden;}
.product-detail-img{
  display:block;
  width:100%;
  margin:0;
  aspect-ratio:4/3;
  object-fit:cover;
  border-radius:calc(var(--r-lg) - 1px) calc(var(--r-lg) - 1px) 0 0;
}
.product-detail-copy{padding:16px 18px 18px;}
.product-modal .modal-x{
  top:12px;right:12px;
  background:rgba(255,255,255,.92);
  box-shadow:0 2px 8px rgba(60,25,80,.18);
}



/* Karta: fotka od kraje ke kraji, zaoblená jen nahoře.
   Padding se přesunul z karty na její textové části. */
.item{padding:0 0 12px;overflow:hidden;}
.item .thumb{
  margin:0;
  width:100%;
  border-radius:21px 21px 0 0;
  aspect-ratio:1 / 1;
}
.item-body{padding:10px 10px 0;}
.item .prices{padding:8px 0 0 10px;}
.item .add,.item .add[aria-pressed="true"]{margin-right:10px !important;}
.badge{top:10px;left:10px;}

@media (max-width:639px){
  .item{padding:0 0 11px;}
  .item .add,.item .add[aria-pressed="true"]{margin-right:10px !important;}
}
@media (max-width:380px){
  .item{border-radius:20px;}
  .item .thumb{border-radius:19px 19px 0 0;}
  .item-body{padding:9px 8px 0;}
  .item .prices{padding-left:8px;}
  .item .add,.item .add[aria-pressed="true"]{margin-right:8px !important;}
}



/* Žádný rámeček karty ani náhledu — fotka končí přesně na hraně. */
.item,
.item:hover{
  border:0 !important;
  outline:0;
  box-shadow:0 3px 14px rgba(74,44,102,.08);
}
.item .thumb,
.item .thumb:hover{
  border:0 !important;
  padding:0 !important;
  background:transparent;
  box-shadow:none !important;
  display:block;
  line-height:0;
}
.item .thumb img{display:block;width:100%;height:100%;object-fit:cover;}



/* Zaoblení náhledu musí být stejné jako u karty, jinak mezi oběma
   křivkami prosvítá bílý roh. */
.item{border-radius:22px;overflow:hidden;background:#fff;}
.item .thumb{border-radius:22px 22px 0 0 !important;}
.item .thumb img{border-radius:inherit;}
@media (max-width:380px){
  .item{border-radius:20px;}
  .item .thumb{border-radius:20px 20px 0 0 !important;}
}



/* Padding karty přebíjela pravidla hustoty — nulujeme i pro ně. */
html[data-density="huste"] .item,
html[data-density="vzdusna"] .item,
html[data-palette] .item{
  padding:0 0 12px;
  border:0;
  border-radius:22px;
}
html[data-density="huste"] .item-body,
html[data-density="vzdusna"] .item-body{padding:10px 10px 0;}
@media (max-width:380px){
  html[data-density="huste"] .item,
  html[data-density="vzdusna"] .item,
  html[data-palette] .item{padding:0 0 11px;border-radius:20px;}
  html[data-density="huste"] .item-body,
  html[data-density="vzdusna"] .item-body{padding:9px 8px 0;}
}



/* Košíkové tlačítko na kartě výrazně větší. */
@media (max-width:639px){
  .item .add,
  .item .add[aria-pressed="true"]{
    width:64px !important;min-width:64px;
    height:60px !important;min-height:60px !important;
    border-radius:18px;
  }
  .item .add .add-cart{width:28px;height:28px;}
  .item .add-count{min-width:22px;height:22px;font-size:.76rem;top:-6px;right:-6px;}
}
@media (max-width:359px){
  .item .add,.item .add[aria-pressed="true"]{
    width:56px !important;min-width:56px;
    height:54px !important;min-height:54px !important;
    border-radius:16px;
  }
  .item .add .add-cart{width:25px;height:25px;}
}



/* Jednotné písmo Poppins v celém dokumentu. */
html,body,button,input,select,textarea,
.confirm h1,.section-head h2,.name,.price,.price-old,
.item .add,.cta,.edit-btn,.tip-copy strong,.modal h2,.modal h3{
  font-family:'Poppins',system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;
}



/* Nejužší displeje: u potvrzení zůstane jen tužka — velká,
   ale o kus menší než košík na kartě. */
@media (max-width:400px){
  .edit-label{display:none;}
  .edit-btn{
    width:54px;min-width:54px;
    height:52px;padding:0;
    border-radius:16px;
    gap:0;
  }
  .edit-btn svg{width:24px;height:24px;}
  .confirm{column-gap:8px;padding:9px 9px 9px 10px;}
}
@media (max-width:359px){
  .edit-btn{width:48px;min-width:48px;height:46px;border-radius:14px;}
  .edit-btn svg{width:21px;height:21px;}
}



/* Mňau tip — jemně fialové pozadí. */
html .tip,
html[data-palette] .tip,
html[data-palette="custom"] .tip{
  background: #f7f1fa !important;
  border-color:#EFE4F7;
}
html .tip:hover,
html[data-palette] .tip:hover{background:#F8F0FE;}



/* Ouška se hýbou patrněji — větší výkyv a rychlejší rytmus. */
@keyframes ousi-vrt-vic{
  0%,100%{transform:rotate(-6deg) translateY(0);}
  25%{transform:rotate(3deg) translateY(-2px);}
  50%{transform:rotate(6deg) translateY(0);}
  75%{transform:rotate(-3deg) translateY(-2px);}
}
.tip .mascot--tip,
html[data-mascot="klid"] .tip .mascot--tip,
html[data-mascot="super"] .tip .mascot--tip{
  animation:ousi-vrt-vic 2.6s ease-in-out infinite;
  transform-origin:50% 92%;
}
html[data-mascot="klid"] .tip .mascot--tip{animation-duration:3.6s;}
html[data-mascot="super"] .tip .mascot--tip{animation-duration:1.6s;}

@media (prefers-reduced-motion:reduce){
  .tip .mascot--tip,
  html[data-mascot="klid"] .tip .mascot--tip,
  html[data-mascot="super"] .tip .mascot--tip{animation:none;}
}



/* Karty v řádku mají různě dlouhé názvy — volné místo si bere
   tělo karty, ne fotka. Tím zmizí mezera nad obrázkem. */
.item{
  grid-template-rows:auto 1fr auto;
  align-content:stretch;
  align-items:stretch;
}
.item .thumb{align-self:start;}
.item-body{align-self:start;}
.item .prices,
.item .add,
.item .add[aria-pressed="true"]{align-self:end;/* margin-top: 6px; */}



/* Tlačítko na kartě má text i na mobilu: „+ Přidat“ / „✓ Přidáno“. */
@media (max-width:639px){
  .item .add,
  .item .add[aria-pressed="true"]{
    width:100% !important;min-width:0;
    height:46px !important;min-height:46px !important;
    border-radius:999px;
    padding:0 10px !important;
    gap:5px;
    justify-self:stretch;
  }
  .item .add .add-icon{display:block;width:15px;height:15px;}
  .item .add .add-label{display:inline;font-size:.88rem;font-weight:700;}
  .item .add-count{
    position:static;
    background:rgba(255,255,255,.30) !important;
    box-shadow:none;
    min-width:18px;height:18px;font-size:.72rem;
  }
}
@media (max-width:359px){
  .item .add,.item .add[aria-pressed="true"]{height:42px !important;min-height:42px !important;padding:0 6px !important;}
  .item .add .add-label{font-size:.8rem;}
  .item .add .add-icon{width:13px;height:13px;}
}
.add-cart{display:none !important;}



/* Výchozí stav je světlejší gradient, hover přejde do sytého. */
.item .add,
.item .add[aria-pressed="true"],
.cta,
.btn-solid,
.product-detail-copy .modal-close,
.modal-close{
  background-image:linear-gradient(rgba(255,255,255,.40),rgba(255,255,255,.40)),var(--grad-cta) !important;
  color:#fff !important;
  text-shadow:0 1px 2px rgba(120,60,140,.20);
  transition:background-image .18s ease,box-shadow .18s ease,filter .18s ease;
}
.item .add:hover,
.item .add:focus-visible,
.item .add:active,
.cta:hover,.cta:focus-visible,.cta:active,
.btn-solid:hover,.btn-solid:focus-visible,
.product-detail-copy .modal-close:hover,
.modal-close:hover{
  background-image:var(--grad-cta) !important;
  filter:none;
  text-shadow:none;
}



/* Mobil: zpátky čtvercové tlačítko s košíkem — text „Přidat“ bral
   cenám moc místa. Po přidání se ikonka mění na fajfku. */
.add-cart{display:none !important;}
@media (max-width:639px){
  .item .add,
  .item .add[aria-pressed="true"]{
    width:64px !important;min-width:64px;
    height:60px !important;min-height:60px !important;
    border-radius:18px;
    padding:0 !important;
    justify-self:end;
    position:relative;overflow:visible;
  }
  .item .add .add-icon,
  .item .add .add-label{display:none !important;}
  .item .add .add-cart{display:block !important;width:28px;height:28px;}
  .item .add-count{
    position:absolute;top:-6px;right:-6px;
    min-width:22px;height:22px;font-size:.76rem;
    background:var(--hot-pink) !important;
    box-shadow:0 0 0 2px #fff;
  }
  .item{grid-template-columns:minmax(0,1fr) auto;}
}
@media (max-width:359px){
  .item .add,.item .add[aria-pressed="true"]{width:56px !important;min-width:56px;height:54px !important;min-height:54px !important;border-radius:16px;}
  .item .add .add-cart{width:25px;height:25px;}
}



/* Ceny o řez lehčí — Poppins 800 působil moc těžce. */
.price{font-weight:600;letter-spacing:-.01em;}
.price-old{font-weight:500;text-decoration-thickness:1.5px;}
.total strong{font-weight:600;}
.product-detail-copy .price{font-weight:600;}



/* Zrušit hned vlevo od Uložit — obě akce vpravo, pole zabírá zbytek. */
.mail-edit{grid-template-columns:minmax(0,1fr) auto auto;}
.mail-edit input{grid-column:1;grid-row:1;}
.mail-edit .btn-ghost{grid-column:2;grid-row:1;justify-self:end;}
.mail-edit .btn-solid{grid-column:3;grid-row:1;justify-self:end;}



/* Přidaný produkt drží sytý gradient — stav je vidět na první pohled. */
.item .add[aria-pressed="true"]{
  background-image:var(--grad-cta) !important;
  text-shadow:none;
  box-shadow:0 3px 12px rgba(178,126,219,.34);
}



/* Menší zaoblení karet — střízlivější, míň bublinaté. */
.confirm,
html[data-palette] .confirm,
html[data-palette="custom"] .confirm{border-radius:16px;}
.tip,
html[data-palette] .tip{border-radius:16px;}
.item,
html[data-density="huste"] .item,
html[data-density="vzdusna"] .item,
html[data-palette] .item{border-radius:14px;}
.item .thumb{border-radius:13px 13px 0 0;}
.story,.faq,.modal{border-radius:16px;}
.tile{border-radius:10px;}
@media (max-width:380px){
  .item,
  html[data-density="huste"] .item,
  html[data-density="vzdusna"] .item,
  html[data-palette] .item{border-radius:13px;}
  .item .thumb{border-radius:12px 12px 0 0;}
  .confirm,html[data-palette] .confirm{border-radius:14px;}
  .tip,html[data-palette] .tip{border-radius:14px;}
}



/* Fotka se ořízne přesně do rohů karty — nic nevyčuhuje. */
.item{overflow:hidden !important;}
.item .thumb{
  overflow:hidden !important;
  border-radius:13px 13px 0 0 !important;
  -webkit-mask-image:-webkit-radial-gradient(#fff,#000); /* ořez v starším WebKitu */
}
.item .thumb img{
  border-radius:13px 13px 0 0;
  display:block;
}
@media (max-width:380px){
  .item .thumb,
  .item .thumb img{border-radius:12px 12px 0 0 !important;}
}



/* Gradient přesně podle dodaného SVG:
   vodorovně #8E42CD → #EB428C + bílý přeliv 40 % shora dolů. */
.item .add{
  background-image:
    linear-gradient(180deg,rgba(255,255,255,.40) 0%,rgba(153,153,153,0) 100%),
    linear-gradient(90deg,#8E42CD 0%,#EB428C 100%) !important;
  text-shadow:none;
}
.item .add[aria-pressed="true"],
.item .add:hover,
.item .add:focus-visible,
.item .add:active{
  background-image:linear-gradient(90deg,#8E42CD 0%,#EB428C 100%) !important;
}
@media (max-width:639px){
  .item .add,
  .item .add[aria-pressed="true"]{border-radius:10px;}
}
@media (max-width:359px){
  .item .add,.item .add[aria-pressed="true"]{border-radius:9px;}
}
.item .add .add-cart{stroke-width:1.5;}



/* Stejný gradient i na hlavním CTA „Doplatit X Kč“ a plných tlačítkách. */
.cta,
.btn-solid,
.product-detail-copy .modal-close,
.modal-close{
  background-image:
    linear-gradient(180deg,rgba(255,255,255,.40) 0%,rgba(153,153,153,0) 100%),
    linear-gradient(90deg,#8E42CD 0%,#EB428C 100%) !important;
  text-shadow:none;
}
.cta:hover,.cta:focus-visible,.cta:active,
.btn-solid:hover,.btn-solid:focus-visible,
.product-detail-copy .modal-close:hover,
.modal-close:hover{
  background-image:linear-gradient(90deg,#8E42CD 0%,#EB428C 100%) !important;
}
.cta{box-shadow:0 4px 16px rgba(180,66,160,.28);}



/* (paleta vrácena na předchozí barvy) */




/* Tlačítko „+ Přidat“ má stejný odstup od pravé hrany jako text zleva. */
@media (min-width:640px){
  .item .add,
  .item .add[aria-pressed="true"]{
    justify-self:center;
    width:calc(100% - 20px) !important;
    margin:0 10px 0 10px !important;
  }
}
@media (max-width:639px){
  .item .add,
  .item .add[aria-pressed="true"]{margin-right:10px !important;}
}
@media (max-width:380px){
  .item .add,
  .item .add[aria-pressed="true"]{margin-right:8px !important;}
}



/* Název může mít až tři řádky, pod ním jen drobná mezera. */
.name{
  display:-webkit-box;
  -webkit-line-clamp:3;
  line-clamp:3;
  -webkit-box-orient:vertical;
  overflow:hidden;
  margin-bottom:2px;
}
.item-body{padding-bottom:2px;}

/* Větší odstup mezi cenou a tlačítkem košíku na kartě produktu. */
.item{column-gap:28px;}

/* Větší odstup mezi názvem produktu a řádkem s cenou/tlačítkem. */
.item-body{padding-bottom:18px;}
.item .prices{/* margin-top:22px; */}

/* O něco menší text názvu produktu. */
.name{font-size:.76rem;}
@media (max-width:380px){
  .name{font-size:.76rem;}
}
@media (min-width:640px){
  .name{font-size:.76rem;}
}

/* ============================================================
   TYPOGRAFICKÁ ŠKÁLA — sladění ostatních textů
   Základ (popisek) .76rem, každá úroveň ×1.25
   .76 → .95 → 1.19 → 1.49 → 1.86rem
   ============================================================ */

/* Běžný text (.95rem) — popisky, odstavce, vedlejší texty */
.confirm p,
.confirm-mail,
.section-head p,
.story-copy p,
.tip-copy span,
.price-old{
  font-size: 0.79rem;
}

/* Podnadpis / H3 (1.19rem) */
.story-copy h3,
.modal h3,
.tip-copy strong{
  font-size: 0.87rem;
}

/* Nadpis / H2 (1.49rem) */
.section-head h2,
.modal h2,
.product-detail-copy h2{
  font-size:1.49rem;
}

/* Hlavní nadpis / H1 — v horním pruhu potvrzení je málo místa
   (sdílí řádek s ikonou a tlačítkem Upravit), takže tu neplatí
   plná škála 1.86rem, jen mírné zvětšení oproti původní velikosti. */
.confirm h1{
  font-size:0.85rem;
}

/* Detail produktu: obrázek byl zaoblený víc než okno modálu okolo
   něj, takže v rožcích prosvítalo bílé pozadí. Sladěno na stejné
   zaoblení jako .modal (16px), o chlup míň, ať přesně sedí uvnitř. */
.product-detail-img{
  border-radius:15px 15px 0 0;
}

/* Zdrojové fotky produktů jsou malé (~130 px). Na celou šířku
   modálu v poměru 4:3 se dost roztahovaly a bylo to vidět
   (rozmazané) — nižší poměr stran (bližší skutečné fotce) snižuje
   potřebné zvětšení a "contain" místo "cover" ho dál nezvětšuje
   ořezem navrch. Šířka zůstává přes celý modál (bez děr po stranách),
   případný pruh nahoře/dole vyplní jemný fialový tón. */
.product-detail-img{
  aspect-ratio:5/4;
  object-fit:contain;
  background:var(--violet-tint);
}

/* Ceny na kartě produktu: vycentrované na výšku (srovnané se
   středem tlačítka vedle), ale doleva — zarovnané se začátkem
   názvu produktu nahoře. */
.item .prices{
  align-self:stretch;
  justify-self:start;
  align-items:flex-start;
  justify-content:center;
  text-align:left;
  margin-top: 16px;
}

/* Tenčí přeškrtnutí u staré ceny, barva zůstává růžová. */
.price-old{
  text-decoration-thickness:.5px;
}

/* Pozadí stránky: jemný bílo-fialový gradient místo ploché barvy,
   karta "Mňau tip" ve světle fialové — !important, protože skript
   s vlastním gradientem nastavuje --bg jako inline styl na <html>,
   který by jinak vyhrál. Gradient je v % zastávkách, takže se
   přizpůsobí jakékoli výšce stránky (responzivní). */
:root{
  --bg:#FFFFFF !important;
}
body{
  /* background:linear-gradient(180deg,#FFFFFF 0%,#FBF8FE 45%,#F3EAFA 100%) !important; */
}
.tip{
  background:#F6F2F9 !important;
}

/* Výraznější stín pod kartami produktů, bez ohraničení —
   kartu odděluje od pozadí jen stín, ne linka kolem. */
.item{
  box-shadow:0 8px 24px rgba(74,44,102,.16);
  border:0;
}

/* Stejné pravidlo napříč stránkou podle reference: žádné rámečky
   kolem karet a pilulkových tlačítek, jen jemný stín. */
.confirm,
.tip,
.edit-btn,
.decline-btn,
.modal,
.cart-panel-body{
  border:0;
}
.confirm{
  /* větší, rozostřenější stín, co jde i přes horní roh (0 0 offset
     místo jen dolů, ať to obklopuje kartu ze všech stran) */
  box-shadow:0 0 32px rgba(74,44,102,.16);
}
.tip{
  /* stín jde dovnitř karty, ne ven */
  box-shadow:inset 0 2px 10px rgba(74,44,102,.10);
}
.edit-btn,
.decline-btn{
  box-shadow:0 2px 8px rgba(74,44,102,.10);
}

/* Větší mezera mezi horním pruhem a kartou "Mňau tip". */
.tip{
  margin-top:16px;
}
