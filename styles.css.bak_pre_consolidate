/* ============================================================
   VIZUÁLNÍ SMĚR — Levandulka
   Fraunces (měkké, lehce rozvrkočené terminály) nese osobnost,
   Poppins drží čitelnost. Papírová blush základna, fíkový inkoust,
   jediné syté místo je hlavní tlačítko.
   ============================================================ */
html[data-palette]{
  --green:#4F7A55;--green-tint:#F3F7EF;
  --palette-confirm:#F3F7EF;--palette-confirm-line:#DCE7D5;--palette-confirm-ink:#3C6547;
  --r-sm:12px;--r-tile:14px;
}
body{
  background:var(--bg);
  color:var(--ink);
  font-family:'Poppins',system-ui,-apple-system,sans-serif;
  font-size:.9375rem;
  line-height:1.55;
  -webkit-font-smoothing:antialiased;
}

/* --- serifová linka: nadpisy, ceny, hlavní tlačítko --- */
.confirm h1,
.section-head h2,
.tip-copy strong,
.summary-note strong,
.price,
.total strong,
.cta,
.timer-face .clock,
.cart-panel-head,
.modal h2,.modal h3{
  font-family:'Poppins',system-ui,-apple-system,sans-serif;
  font-variation-settings:'opsz' 32;
  font-weight:600;
  letter-spacing:-.005em;
}
.confirm h1{font-size:1.28rem;line-height:1.25;white-space:normal;}
.section-head h2{font-size:1.4rem;font-weight:600;letter-spacing:-.018em;}
.tip-copy strong{font-size:1.3rem;}
.summary-note strong{font-size:1.15rem;}
.price{font-size:1.22rem;font-weight:600;font-variant-numeric:tabular-nums;}
.total strong{font-size:1.75rem;font-weight:600;font-variant-numeric:tabular-nums;}
.timer-face .clock{font-size:1.32rem;font-variant-numeric:tabular-nums;letter-spacing:-.02em;}
.cta{font-size:1.06rem;}

/* --- sans linka: všechno ostatní --- */
.confirm p,.confirm p b,
.section-head p,
.tip-copy span,
.name,.price-old,.add,
.summary-note span,.total span,
.summary-toggle span,
.cart-row-name,.cart-panel-head span{
  font-family:'Poppins',system-ui,-apple-system,sans-serif;
  font-variation-settings:normal;
}
.confirm p{font-size:.9rem;}
.section-head p{font-size:.9rem;max-width:48ch;}
.tip-copy span{font-size:.9rem;color:var(--ink-muted);}
.name{font-size:.92rem;font-weight:500;line-height:1.35;letter-spacing:.002em;}
.price-old{font-size:.78rem;font-weight:400;}
.add{font-size:.85rem;font-weight:600;letter-spacing:.004em;}

/* --- barvy a plochy vázané na paletu, ne na natvrdo zapsané hex --- */
.confirm{background:var(--palette-confirm);border-color:var(--palette-confirm-line);border-radius:18px;}
.confirm h1{color:var(--palette-confirm-ink);}
.confirm p{color:var(--ink-muted);}
.tip{background:var(--violet-tint);border-color:var(--line);border-radius:20px;}
.item{border-color:var(--line);border-radius:16px;box-shadow:0 2px 8px rgba(58,52,54,.05);}
.thumb{border-radius:13px;}
.heading-paw{color:var(--violet);}
.timer .track{stroke:var(--line);}
#ringGrad stop:first-child{stop-color:var(--ring-a);}
#ringGrad stop:last-child{stop-color:var(--ring-b);}
.summary{box-shadow:0 -3px 18px rgba(58,52,54,.09);}
.summary-inner{border-radius:18px;}
.tile{border-radius:14px;}

/* Kontrast na tlačítkách se dopočítá z gradientu, ne natvrdo bílá. */
.add{color:var(--on-add);box-shadow:0 2px 7px rgba(58,52,54,.10);}
.add:hover{box-shadow:0 4px 12px rgba(58,52,54,.16);}
.add[aria-pressed="true"]{color:var(--on-add);}
.add-count{background:var(--on-add-chip);}
.cta{color:var(--on-cta);box-shadow:0 4px 16px rgba(58,52,54,.18);}

/* Jediný nečekaný detail: podtržení nadpisu sekce tenkou vlnkou v akcentu. */
.section-head h2{
  display:inline-block;
  padding-bottom:3px;
  background:linear-gradient(90deg,var(--violet),transparent) bottom left / 62% 2px no-repeat;
}

/* ============================================================
   HERO — poděkování v duchu papírové kartičky
   Bodoni Moda ve verzálkách, přes ni růžový skript.
   ============================================================ */
.hero{
  position:relative;
  margin:0 0 var(--s5);
  padding:var(--s6) var(--s4) var(--s5);
  text-align:center;
  overflow:hidden;
}
.hero-petal{
  position:absolute;
  width:230px;height:210px;
  opacity:.5;
  pointer-events:none;
  filter:blur(.4px);
}
.hero-petal--a{top:-86px;right:-64px;transform:rotate(12deg);}
.hero-petal--b{bottom:-96px;left:-70px;transform:rotate(-158deg);}
.hero-title{
  position:relative;
  margin:0;
  font-family:'Poppins',system-ui,-apple-system,sans-serif;
  font-variation-settings:'opsz' 96;
  font-weight:700;
  font-size:clamp(2.5rem,11vw,4.6rem);
  line-height:.94;
  letter-spacing:.055em;
  text-transform:uppercase;
  color:var(--ink);
}
.hero-script{
  display:block;
  margin-top:-.42em;
  font-family:'Poppins',system-ui,-apple-system,sans-serif;
  font-size:.44em;
  font-weight:400;
  line-height:1;
  letter-spacing:.01em;
  text-transform:none;
  color:var(--script);
}
.hero-sub{
  max-width:34ch;
  margin:var(--s4) auto 0;
  font-family:'Poppins',system-ui,-apple-system,sans-serif;
  font-size:.9rem;
  line-height:1.6;
  color:var(--ink-muted);
}
@media (min-width:640px){
  .hero{padding:var(--s7) var(--s4) var(--s6);}
  .hero-petal{width:320px;height:290px;}
  .hero-petal--a{top:-116px;right:-88px;}
  .hero-petal--b{bottom:-130px;left:-96px;}
}
@media (prefers-reduced-motion:no-preference){
  .hero-title{animation:hero-rise .7s cubic-bezier(.22,1,.36,1) both;}
  .hero-script{animation:hero-rise .7s cubic-bezier(.22,1,.36,1) .12s both;}
}
@keyframes hero-rise{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:none;}}

/* Skript se objeví ještě jednou u tipu od Levandulky — jinde ne. */
.tip-copy strong{
  font-family:'Poppins',system-ui,-apple-system,sans-serif;
  font-weight:400;
  font-size:1.5rem;
  letter-spacing:.005em;
  color:var(--script);
}

/* ============================================================
   ZKLIDNĚNÍ — barva jen tam, kde nese informaci
   ============================================================ */
.hero-petal{opacity:.34;}
.section-head h2{background:none;padding-bottom:0;}
.tile{background:var(--violet-tint);color:var(--ink);}
.tip{background:var(--violet-tint);border-color:var(--line);}
.heading-paw,.tip-paw,.tip-watermark{display:none;}
.tip-copy strong{color:var(--ink);}
.price{color:var(--ink);}
.price-old{color:var(--ink-faint);}
.add{
  background:var(--grad-add);
  color:var(--ink);
  box-shadow:none;
  border:1px solid var(--line);
}
.add:hover{filter:none;background:var(--line-soft);box-shadow:none;}
.add[aria-pressed="true"]{
  background:var(--violet);
  color:#fff;
  border-color:var(--violet);
}
.add-count{background:rgba(255,255,255,.24);}
.add[aria-pressed="false"] .add-count{background:rgba(58,52,54,.09);}
.item{box-shadow:none;}
.item:hover{box-shadow:0 3px 12px rgba(58,52,54,.07);}
.cta{box-shadow:0 3px 12px rgba(58,52,54,.16);}
.summary-toggle{color:var(--ink);}
.confirm{background:var(--surface);border-color:var(--line);}
.confirm h1{color:var(--ink);}

/* ============================================================
   TYPOGRAFICKÉ MĚŘÍTKO — o stupeň výš, ať se to dobře čte
   ============================================================ */
body{font-size:1rem;line-height:1.6;}

.hero-title{font-size:clamp(2.9rem,12vw,5.2rem);}
.hero-sub{font-size:1.02rem;max-width:36ch;}

.confirm h1{font-size:1.45rem;}
.confirm p{font-size:1rem;}

.section-head h2{font-size:1.62rem;}
.section-head p{font-size:1rem;max-width:52ch;}

.tip-copy strong{font-size:1.78rem;}
.tip-copy span{font-size:1rem;}

.name{font-size:1.02rem;line-height:1.4;}
.price{font-size:1.4rem;}
.price-old{font-size:.875rem;}
.add{font-size:.98rem;min-height:44px;height:44px;}
.add[aria-pressed="true"]{min-height:44px;height:44px;}
.add-count{min-width:22px;height:22px;font-size:.78rem;}

.summary-note strong{font-size:1.32rem;}
.summary-note span{font-size:.95rem;}
.total span{font-size:.9rem;}
.total strong{font-size:2rem;}
.timer-face .clock{font-size:1.5rem;}
.timer-face .paw{width:26px;height:26px;}
.cta{font-size:1.18rem;min-height:54px;padding:12px 26px;}
.summary-toggle{height:46px;font-size:1.06rem;}
.summary-toggle span{font-size:1.06rem;}

.cart-row-name{font-size:1rem;}
.cart-panel-head{font-size:.95rem;}

@media (max-width:520px){
  .confirm h1{font-size:1.28rem;}
  .section-head h2{font-size:1.42rem;}
  .tip-copy strong{font-size:1.55rem;}
  .total strong{font-size:1.75rem;}
  .cta{font-size:1.06rem;min-height:50px;}
  .summary-note strong{font-size:1.15rem;}
}

/* ============================================================
   Odpočet o 20 % větší, hlavní věta výraznější, podtitulek tišší
   ============================================================ */
.summary-top .timer,
.summary-top .timer svg.ring{width:134px;height:134px;}
.timer-face .clock{font-size:1.8rem;}
.timer-face .paw{width:31px;height:31px;}

@media (max-width:1023px){
  .summary-top .timer,
  .summary-top .timer svg.ring{width:115px;height:115px;}
  .timer-face .clock{font-size:1.6rem;}
  .timer-face .paw{width:27px;height:27px;}
}

.summary-note strong{font-size:1.55rem;line-height:1.2;}
.summary-note span{font-size:.82rem;}
.summary[data-state="empty"] .summary-note strong{font-size:1.62rem;}

@media (max-width:520px){
  .summary-note strong,
  .summary[data-state="empty"] .summary-note strong{font-size:1.35rem;}
  .summary-note span{font-size:.78rem;}
}

/* ============================================================
   Zaoblení rohů řídí jeden posuvník v nástroji
   ============================================================ */
.confirm{border-radius:var(--r-card);}
.tip{border-radius:calc(var(--r-card) + 2px);}
.item{border-radius:var(--r-card);}
.thumb{border-radius:var(--r-thumb);}
.tile{border-radius:var(--r-tile);}
.summary-inner{border-radius:var(--r-card);}
.add,.add[aria-pressed="true"]{border-radius:var(--r-btn);}
.cart-row img{border-radius:var(--r-thumb);}
.product-detail-img{border-radius:var(--r-card);}
.modal{border-radius:calc(var(--r-card) + 2px);}
.cart-panel-body,.pay-rows,.qr{border-radius:var(--r-card);}
.cat-fx{border-radius:var(--r-thumb);}
/* Tlačítka jdou s posuvníkem taky, jen s větším násobkem — na maximu
   z nich vyjde pilulka, na nule ostrý roh. */
.cta,
.summary-toggle,
.btn-solid,.btn-ghost,
.icon-btn,
.qty-controls button,
.mail-edit input,
.mail-edit button{border-radius:calc(var(--r-card) * 1.75);}
.add-count{border-radius:999px;}

/* ============================================================
   MOBIL — sticky souhrn musí být kompaktní.
   Zvětšená typografie platí pro obsah stránky, ne pro lištu.
   ============================================================ */
