/* --- Létající superkočka: plynulé stoupání a klesání --- */
@keyframes kocka-let{
  0%{transform:translateY(-7px) rotate(-2.4deg);}
  50%{transform:translateY(7px) rotate(2.4deg);}
  100%{transform:translateY(-7px) rotate(-2.4deg);}
}
