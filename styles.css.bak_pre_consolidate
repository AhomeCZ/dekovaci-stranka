/* ============================================================
   ÚPRAVA: tiskací písmo všude, jednořádkové potvrzení,
   nižší sticky lišta, větší ovládání množství na mobilu
   ============================================================ */

/* Váha a prostrkání teď nesou hierarchii místo řezu písma. */
.confirm h1,.section-head h2,.tip-copy strong,.summary-note strong,
.price,.total strong,.cta,.timer-face .clock,.cart-panel-head,
.hero-title,.hero-script{
  font-family:'Poppins',system-ui,-apple-system,sans-serif;
  font-variation-settings:normal;
  font-weight:700;
  letter-spacing:-.015em;
