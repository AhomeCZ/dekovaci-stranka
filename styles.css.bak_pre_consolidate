/* Nejužší telefony — odpočet a kočka ustoupí ceně a tlačítku. */
@media (max-width:400px){
  .summary-top .timer,
  .summary-top .timer svg.ring{width:52px;height:52px;}
  .timer-face .clock{font-size:.9rem;}
  .summary-note span{display:none;}
  .summary[data-state="filled"] .cat-fx{flex-basis:52px;width:52px;height:40px;}
  .cta{font-size:.86rem;padding:8px 12px;margin-left:6px;}
